---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL for og:image (optional until 1.3 finalizes site-wide meta). */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const isPreview = import.meta.env.PUBLIC_PREVIEW === '1';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {isPreview && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href={withBase('favicon.ico')} />
    <!-- Open Graph / Twitter (home meta — Phase 1.1; site-wide pass in 1.3) -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
  </head>
  <body
    class="flex min-h-dvh flex-col"
    style={`background-image: url('${withBase('background/background-noise.webp')}');`}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>