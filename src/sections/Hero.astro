---
/**
 * R5-6 section partition: Home hero (was part of index.astro).
 * Updated to place social profiles in a dedicated vertical rail on the left of text content.
 */
import { Image } from 'astro:assets';
import HeroDotMatrix from '../components/HeroDotMatrix.astro';
import Icon from '../components/Icon.astro';
import { resumePdf } from '../lib/paths';

interface Props {
  email: string;
  github: string;
  linkedin: string;
  leetcode?: string;
  devto: string;
  portrait: ImageImport;
}

type ImageImport = Parameters<typeof Image>[0]['src'];

const { email, github, linkedin, leetcode, devto, portrait } = Astro.props;
---

<section id="home" class="hero-section">
  <HeroDotMatrix />
  <div class="container-site hero-inner">
    <!-- Main Left Column: Vertical Social Rail + Text Content -->
    <div class="hero-left-layout">
      <!-- Vertical Social Links Rail -->
      <nav class="hero-social-rail delay-200 animate-fade-up" aria-label="Social and coding profiles">
        <a
          href={github}
          class="hero-social-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
        >
          <Icon name="github" size={24} strokeWidth={2.2} />
        </a>
        <a
          href={linkedin}
          class="hero-social-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <Icon name="linkedin" size={30} strokeWidth={2.2} />
        </a>
        {leetcode && (
          <a
            href={leetcode}
            class="hero-social-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LeetCode profile"
            title="LeetCode"
          >
            <Icon name="leetcode" size={24} strokeWidth={2.2} />
          </a>
        )}
        <a
          href={devto}
          class="hero-social-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="dev.to blog"
          title="dev.to"
        >
          <Icon name="devto" size={24} strokeWidth={2.2} />
        </a>
      </nav>

      <!-- Identity text block -->
      <div class="hero-content hero-textshadow">
        <!-- Name — single line -->
        <h1 class="hero-name delay-100 animate-fade-up">
          Kashif Rezwi
        </h1>

        <!-- Role line (consistent with title/meta/positioning) — skewed accent badge -->
        <p class="hero-role delay-300 animate-fade-up">
          <span class="hero-role-badge">
            <span class="hero-role-text-inner">Frontend-focused Full Stack Engineer</span>
          </span>
        </p>

        <!-- Direction — old deployed accent style restored -->
        <p class="hero-direction delay-350 animate-fade-up">
          <span class="gradient-text">Building toward AI product engineering</span>
          <br />
          and developer tools
        </p>

        <!-- Bio -->
        <p class="hero-bio delay-400 animate-fade-up">
          2+ years building customer-facing SaaS products in startup teams:
          landing-page builders, CRM, and campaign &amp; workflow automation.
          Currently building AI products and developer tools.
        </p>

        <!-- CTA row -->
        <div class="hero-ctas delay-500 animate-fade-up">
          <a
            href={resumePdf}
            class="btn"
            target="_blank"
            rel="noopener noreferrer"
            download
            aria-label="Download resume (PDF, opens in a new tab)"
          >
            Resume (PDF) ↓
          </a>
          <a href={`mailto:${email}`} class="btn-outline">Email me</a>
        </div>
      </div>
    </div>

    <!-- Portrait -->
    <div class="hero-portrait delay-300 animate-fade-up">
      <div class="portrait-wrapper">
        <Image
          src={portrait}
          alt="Portrait of Kashif Rezwi"
          width={320}
          height={320}
          format="avif"
          quality={70}
          loading="eager"
          fetchpriority="high"
          class="portrait-img"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: clamp(600px, calc(100svh - 65px), 860px);
    padding-block: 5rem 4rem;
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    position: relative;
    z-index: 1;
    margin-top: -4.5rem;
  }

  .hero-left-layout {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 1;
    min-width: 0;
  }

  .hero-social-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .hero-social-btn {
    color: var(--color-ink-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    text-decoration: none;
    background: transparent;
    border: none;
    padding: 0;
    line-height: 1;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease, filter var(--duration-fast) ease;
  }

  .hero-social-btn svg {
    display: block;
  }

  .hero-social-btn:hover {
    color: var(--color-accent-light);
    transform: translateY(-2px) scale(1.12);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--color-accent) 45%, transparent));
  }

  /* T1 (R5-8a): subtle text-legibility treatment over the live dot matrix */
  .hero-textshadow {
    text-shadow:
      0 1px 2px color-mix(in srgb, var(--color-canvas) 55%, transparent),
      0 0 18px color-mix(in srgb, var(--color-canvas) 40%, transparent);
    -webkit-text-stroke: 0.5px color-mix(in srgb, var(--color-canvas) 22%, transparent);
  }
  /* Reset inherited shadow on interactive children */
  .hero-textshadow .btn,
  .hero-social-btn {
    text-shadow: none;
    -webkit-text-stroke: 0;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
    min-width: 0;
  }

  .hero-name {
    font-size: clamp(2.25rem, 6.5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-role {
    margin: 0.5rem 0 0;
  }

  .hero-role-badge {
    display: inline-block;
    padding: 0.45rem 0.9rem 0.45rem 1.1rem;
    background: var(--color-accent-badge);
    border-radius: 0;
    transform: skewX(-8deg);
    transform-origin: center;
    box-shadow: 0 2px 0 color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
  .hero-role-text-inner {
    display: inline-block;
    transform: skewX(8deg);
    font-size: clamp(1.05rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .hero-direction {
    font-size: clamp(1.05rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink-muted);
    margin: 0.75rem 0 0;
  }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    max-width: 58ch;
    margin: 0.75rem 0 0;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .hero-portrait {
    flex-shrink: 0;
  }
  .portrait-wrapper {
    position: relative;
    width: 220px;
    height: 220px;
  }
  .portrait-wrapper::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: -8px;
    background: var(--color-accent);
    clip-path: polygon(30% 4%, 70% 4%, 88% 18%, 100% 48%, 86% 78%, 50% 100%, 24% 90%, 10% 76%, 3% 56%, 6% 34%, 18% 12%);
    transition: inset 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }
  .hero-portrait:hover .portrait-wrapper::after {
    inset: 0;
    transform: translate(10px, 12px);
  }
  .portrait-img {
    position: relative;
    z-index: 1;
    width: 220px;
    height: 220px;
    object-fit: cover;
    background-color: #a9c8ff;
    clip-path: polygon(30% 4%, 70% 4%, 88% 18%, 100% 48%, 86% 78%, 50% 100%, 24% 90%, 10% 76%, 3% 56%, 6% 34%, 18% 12%);
    transition: transform 0.35s ease;
  }
  .hero-portrait:hover .portrait-img {
    transform: translate(-6px, -6px);
  }

  @media (min-width: 1024px) {
    .portrait-wrapper,
    .portrait-img {
      width: 260px;
      height: 260px;
    }
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .hero-inner {
      margin-top: -2rem;
    }
  }

  @media (max-width: 768px) {
    .hero-inner {
      flex-direction: column-reverse;
      gap: 2rem;
      margin-top: 0;
    }
    .hero-left-layout {
      flex-direction: column;
      gap: 1.25rem;
    }
    .hero-social-rail {
      flex-direction: row;
      padding-top: 0;
      gap: 1.125rem;
    }
    .portrait-wrapper {
      width: 160px;
      height: 160px;
    }
    .portrait-img {
      width: 160px;
      height: 160px;
    }
    .hero-section {
      padding-block: 3rem 2.5rem;
    }
  }
</style>