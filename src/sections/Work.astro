---
/**
 * R5-6 section partition: Selected work (was part of index.astro).
 * Styles relocated verbatim from index.astro's scoped block.
 */
import WorkCard from '../components/WorkCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import GitHubContributions from '../components/GitHubContributions.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { withBase } from '../lib/paths';

interface Props {
  featured: Array<{
    data: {
      title: string;
      roleLabel: string;
      period: string;
      status: string;
      summary: string;
      repo: string;
      demo?: string;
      tech?: string[];
      cover?: string;
    };
    id: string;
  }>;
}

const { featured } = Astro.props;
---

<section id="work" class="section-block work-bg">
  <div class="container-site">
    <SectionHeader
      label="Projects"
      title="Things I've built"
      subtitle="AI products and developer tools, built as personal projects with live demos."
    />

    <div class="work-grid">
      {featured.map((entry, i) => (
        <div class={`reveal delay-${(i + 1) * 100}`}>
          <WorkCard
            title={entry.data.title}
            roleLabel={entry.data.roleLabel}
            period={entry.data.period}
            status={entry.data.status}
            summary={entry.data.summary}
            repo={entry.data.repo}
            demo={entry.data.demo}
            tech={entry.data.tech}
            href={withBase(`work/${entry.id}/`)}
            cover={entry.data.cover}
          />
        </div>
      ))}
    </div>

    <!-- More projects compact list -->
    <div class="more-projects reveal glass-role-surface">
      <h3 class="more-projects-label">More projects</h3>
      <ul class="more-projects-list">
        <ProjectRow
          name="Interactive Lessons"
          typeLabel="Personal project"
          links={[
            { href: withBase('work/interactive-lessons/'), label: 'Read case study', icon: 'case-study', internal: true },
            { href: 'https://github.com/Kashif-Rezwi/interactive-lessons', label: 'Repo', icon: 'repository' },
          ]}
        >
          Documentation-first, agent-governed pipeline that turns technical course material into rigorously evaluated, interactive HTML lessons.
        </ProjectRow>
        <ProjectRow
          name="LingoAgent"
          typeLabel="Personal project"
          links={[
            { href: withBase('work/lingo-agent/'), label: 'Read case study', icon: 'case-study', internal: true },
            { href: 'https://github.com/Kashif-Rezwi/lingo-agent', label: 'Repo', icon: 'repository' },
            { href: 'https://lingo-agent.vercel.app', label: 'Live', icon: 'external' },
          ]}
        >
          Full-stack AI agent pipeline for Next.js App Router repos — 7 deterministic tools, E2B sandbox execution, Babel AST extraction, auto PR with preview deploy.
        </ProjectRow>
      </ul>
    </div>

    <!-- Public GitHub contribution calendar (build-time snapshot, local SVG) -->
    <GitHubContributions />
  </div>
</section>

<style>
  /* Band duty-swap (nav-order fix): the fade-in ramp moved to Skills (which now
     opens the band); Work is flat band so the band runs Skills → Work →
     Experience → Testimonials → Now uninterrupted. */
  .work-bg {
    background: color-mix(in srgb, var(--color-surface) 40%, var(--color-canvas));
  }
  /* R5-6: scoped styles moved from index.astro — byte-identical. */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  /* Four featured cards: auto-fill yields a 3+1 orphan at desktop widths
     (4 tracks need ~1420px; the container offers ~1104px). Two equal
     columns ≥1024px give a balanced 2×2; narrower widths keep auto-fill
     (2-up tablet, 1-up mobile) — no orphan row at any width. */
  @media (min-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .more-projects {
    /* bg + border come from the shared .glass-role-surface recipe so the
       global primary-tint hover applies. */
    border-radius: var(--radius-card);
    padding: 1.5rem;
    position: relative;
  }
  .more-projects-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim-glass);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .more-projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
