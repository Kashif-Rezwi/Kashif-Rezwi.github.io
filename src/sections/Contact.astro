---
/** Contact layout and dot field; glyph rendering is provided by Nanodes. */
import HeroDotMatrix from '../components/HeroDotMatrix.astro';
import Icon from '../components/Icon.astro';
import GlassPanel from '../components/GlassPanel.astro';
import ContactTech from '../components/ContactTech.astro';

interface Props {
  links: {
    email: string;
    github: string;
    linkedin: string;
    leetcode?: string;
    devto: string;
  };
}

const { links } = Astro.props;
---

<section id="contact" class="section-block contact-section">
  <HeroDotMatrix />
  <div class="container-site contact-inner">
    <!-- Main Left Column: Vertical Social Rail + Text Content (Identical to Hero layout) -->
    <div class="contact-left-layout">
      <!-- Vertical Social Links Rail -->
      <nav class="contact-social-rail" aria-label="Contact and social profiles">
        <a
          href={links.github}
          class="contact-social-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
        >
          <Icon name="github" size={24} strokeWidth={2.2} />
        </a>
        <a
          href={links.linkedin}
          class="contact-social-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          title="LinkedIn"
        >
          <Icon name="linkedin" size={30} strokeWidth={2.2} />
        </a>
        {links.leetcode && (
          <a
            href={links.leetcode}
            class="contact-social-btn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LeetCode profile"
            title="LeetCode"
          >
            <Icon name="leetcode" size={24} strokeWidth={2.2} />
          </a>
        )}
        <a
          href={links.devto}
          class="contact-social-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="dev.to blog"
          title="dev.to"
        >
          <Icon name="devto" size={24} strokeWidth={2.2} />
        </a>
      </nav>

      <!-- Identity & Contact text block -->
      <GlassPanel variant="panel" class="contact-content glass-role-surface">
        <p class="section-label">Contact</p>
        <h2 class="contact-heading">
          Let's build something<br />
          <span class="gradient-text">worth shipping.</span>
        </h2>
        <p class="contact-sub">
          For freelance projects and conversations, reach me by email or phone, or find me on GitHub, LinkedIn, and dev.to.
        </p>

        <!-- CTA row -->
        <div class="contact-ctas">
          <a href={`mailto:${links.email}`} class="btn">
            Send an email →
          </a>
          <span class="contact-email-plain">
            {links.email}
          </span>
        </div>

        <!-- Extra Direct Meta (Phone & Location) -->
        <div class="contact-extra-meta">
          <a href={`tel:9883909187`} class="contact-meta-link"><Icon name="phone" size={15} />+91 98839 09187</a>
          <span class="contact-meta-location"><Icon name="location" size={15} />Bengaluru, India</span>
        </div>
      </GlassPanel>
    </div>

    <!-- Right Column: Pure Borderless High-Density ASCII Visual Element (Symmetrically aligned like Hero Portrait) -->
    <div class="contact-right-element">
      <ContactTech />
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-block: 5rem 4.5rem;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .contact-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    position: relative;
    z-index: 1;
  }

  /* Left Side: Vertical Social Rail + Content (Identical to Hero layout) */
  .contact-left-layout {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
    min-width: 0;
  }

  .contact-social-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .contact-social-btn {
    color: var(--color-ink-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    text-decoration: none;
    background: transparent;
    border: none;
    padding: 0;
    line-height: 1;
    transition: color var(--duration-fast) ease, transform var(--duration-fast) ease, filter var(--duration-fast) ease;
  }

  .contact-social-btn svg {
    display: block;
  }

  .contact-social-btn:hover {
    color: var(--color-accent-light);
    transform: translateY(-2px) scale(1.12);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--color-accent) 45%, transparent));
  }

  /* GlassPanel renders its wrapper in its own component scope, so this
     intentionally targets the supplied class globally. Without :global,
     the panel loses its padding and width constraints. */
  :global(.contact-content) {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
    min-width: 0;
    max-width: 580px;
    box-sizing: border-box;
    padding: 1.5rem 1.75rem;
  }

  .contact-heading {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin: 0;
    color: var(--color-ink);
  }

  .contact-sub {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    max-width: 52ch;
    margin: 0;
    line-height: 1.65;
  }

  .contact-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .contact-email-plain {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-dim);
  }

  .contact-extra-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }

  .contact-meta-link,
  .contact-meta-location {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-dim);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .contact-meta-link:hover {
    color: var(--color-accent-text);
  }

  /* Right Side: Symmetrically Aligned (Matching Hero Portrait) */
  .contact-right-element {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  @media (max-width: 1100px) {
    .contact-inner {
      /* ASCII visual element leads on narrow screens (symmetric with Hero portrait),
         followed by the social rail and contact card. */
      flex-direction: column-reverse;
      gap: 2.5rem;
    }

    .contact-left-layout {
      flex-direction: column;
      gap: 1.25rem;
      width: 100%;
    }

    .contact-social-rail {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 1.25rem;
      width: 100%;
      margin-bottom: 0.25rem;
    }

    .contact-right-element {
      width: 100%;
    }

    :global(.contact-content) {
      max-width: 38rem;
    }
  }

  @media (max-width: 480px) {
    .contact-heading {
      font-size: clamp(1.75rem, 7vw, 2.5rem);
    }
    .contact-ctas {
      flex-wrap: wrap;
    }
    :global(.contact-content) {
      padding: 1.25rem;
    }
  }
</style>
