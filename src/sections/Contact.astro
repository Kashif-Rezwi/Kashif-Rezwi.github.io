---
/**
 * R5-6 section partition: Contact (was part of index.astro).
 * Markup + scoped styles relocated verbatim from index.astro.
 */
import HeroDotMatrix from '../components/HeroDotMatrix.astro';
import Icon from '../components/Icon.astro';

interface Props {
  links: {
    email: string;
    github: string;
    linkedin: string;
    devto: string;
  };
}

const { links } = Astro.props;
---

<section id="contact" class="section-block contact-section">
  <HeroDotMatrix />
  <div class="container-site">
    <div class="contact-inner reveal">
      <p class="section-label">Contact</p>
      <h2 class="contact-heading">
        Let's build something<br />
        <span class="gradient-text">worth shipping.</span>
      </h2>
      <p class="contact-sub">
        For freelance projects and conversations, reach me by email or phone, or find me on GitHub, LinkedIn, and dev.to.
      </p>
      <div class="contact-ctas">
        <a href={`mailto:${links.email}`} class="btn">
          Send an email →
        </a>
        <span class="contact-email-plain">
          {links.email}
        </span>
      </div>
      <div class="contact-links">
        <a href={links.github} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} />GitHub</a>
        <a href={links.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={16} />LinkedIn</a>
        <a href={links.devto} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="devto" size={16} />dev.to</a>
        <a href={`tel:9883909187`} class="contact-link"><Icon name="phone" size={16} />+91 98839 09187</a>
        <span class="contact-location"><Icon name="location" size={16} />Kolkata, India</span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-block: 5rem;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .contact-inner {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  .contact-heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    margin: 0;
    color: var(--color-ink);
  }
  .contact-sub {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    max-width: 52ch;
    margin: 0;
    line-height: 1.65;
  }
  .contact-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .contact-email-plain {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-dim);
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .contact-link,
  .contact-location {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .contact-link:hover {
    color: var(--color-accent-text);
  }
  .contact-location {
    color: var(--color-ink-dim);
  }
</style>