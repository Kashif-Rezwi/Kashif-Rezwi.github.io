---
/**
 * R5-6 section partition: Now / Current Focus (was "AI journey").
 * Renamed and restructured: section now answers "What are you doing right
 * now?" rather than summarising the completed project grid.
 * Style refinement: full-container-width card, icons inline with their
 * category labels (About pillar-header recipe), accent mono label hierarchy.
 * Content untouched.
 */
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GlassPanel from '../components/GlassPanel.astro';
import { withBase } from '../lib/paths';

interface Props {
  links: {
    npmPackage: string;
  };
}

const { links } = Astro.props;
---

<section id="now" class="section-block now-bg">
  <div class="container-site">
    <SectionHeader label="Now" title="Current Focus" />

    <GlassPanel variant="card" class="now-card reveal glass-role-surface">
      <p class="now-card-label">I develop new capabilities by turning what I learn into complete working systems — then writing about the decisions that shaped how they work.</p>
      <div class="now-list">
        <div class="now-row">
          <div class="now-row-head">
            <span class="now-row-icon"><Icon name="sparkles" size={15} strokeWidth={2} /></span>
            <h4 class="now-row-title">Building</h4>
          </div>
          <p class="now-row-desc">
            An agent-governed lesson pipeline that turns raw technical course material into rigorously evaluated, interactive HTML lessons — enforced by versioned prompt contracts, append-only evidence records, and a six-audit adversarial gate before anything releases. <a href={withBase('work/interactive-lessons/')} class="link-accent">Read the case study →</a>
          </p>
        </div>
        <div class="now-row">
          <div class="now-row-head">
            <span class="now-row-icon"><Icon name="writing" size={15} strokeWidth={2} /></span>
            <h4 class="now-row-title">Shipping</h4>
          </div>
          <p class="now-row-desc">
            I’m turning recurring engineering problems into small, reusable tools and shipping them for others to use — most recently <a href={links.npmPackage} class="link-accent" target="_blank" rel="noopener noreferrer">server-active-indicator</a>, built to solve a UX problem I kept encountering across my own free-tier projects. It ships with a 5-state lifecycle, adaptive backoff, a React adapter, and zero runtime dependencies.
            <span class="now-row-meta">· npm · v0.3.2 · MIT</span>
          </p>
        </div>
        <div class="now-row">
          <div class="now-row-head">
            <span class="now-row-icon"><Icon name="learning" size={15} strokeWidth={2} /></span>
            <h4 class="now-row-title">EXPLORING</h4>
          </div>
          <p class="now-row-desc">
            I'm continuously deepening my AI and software-engineering practice by using frontier models, coding agents, and AI-assisted development tools in my day-to-day workflow — from brainstorming and system design to implementation, debugging, and iteration. I experiment with different models and approaches, learning where they add real value and where careful engineering judgment still matters.
          </p>
        </div>
      </div>
    </GlassPanel>
  </div>
</section>

<style>
  /* Gradient background: holds alt-blend from the top (matching Testimonials’
     solid bottom), then fades to canvas in the last 160px so Contact’s
     canvas top is a seamless continuation. Entirely solid colours. */
  .now-bg {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-surface) 40%, var(--color-canvas)) 0%,
      var(--color-canvas) 100%
    );
  }
  /* Full-container-width glass shelf (the more-projects / experience ledger
     treatment): the card spans the container and its content fills the width. */
  :global(.now-card) {
    padding: 1.75rem 2rem;
    position: relative;
    width: 100%;
  }
  @media (max-width: 640px) {
    :global(.now-card) {
      padding: 1.25rem 1.5rem;
    }
  }
  /* Frame statement: editorial mono note in sentence case (DL-102). */
  .now-card-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-dim-glass);
    letter-spacing: normal;
    text-transform: none;
    margin: 0 0 1.5rem 0;
  }
  .now-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .now-row {
    display: flex;
    flex-direction: column;
  }
  /* Icon sits inline with its category label — the portfolio's pillar-header
     recipe (About) — instead of leading the text from a dedicated gutter
     column, which read as an empty left rail. */
  .now-row-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .now-row-icon {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
    color: var(--color-accent-text);
  }
  .now-row-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent-text);
    margin: 0;
  }
  .now-row-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .now-row-meta {
    color: var(--color-ink-dim-glass);
  }
</style>
