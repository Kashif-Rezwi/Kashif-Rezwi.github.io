---
/**
 * R5-6 section partition: Experience (was part of index.astro).
 * Markup + scoped styles relocated verbatim from index.astro.
 */
import SectionHeader from '../components/SectionHeader.astro';
---

<section id="experience" class="section-block exp-bg">
  <div class="container-site">
    <SectionHeader label="Experience" title="Where I've worked" />

    <div class="experience-list">
      <!-- Brand Exponents -->
      <article class="exp-item reveal">
        <div class="exp-timeline-marker" aria-hidden="true"></div>
        <div class="exp-content">
          <div class="exp-header">
            <div>
              <h3 class="exp-title">Full Stack Developer</h3>
              <p class="exp-company">
                Brand Exponents Creatives Pvt Ltd
                <span class="exp-badge">Swipe One · Swipe Pages</span>
              </p>
            </div>
            <p class="exp-period">Oct 2023 – Aug 2025</p>
          </div>
          <div class="exp-product">
            <h4 class="exp-product-title">Swipe One</h4>
            <ul class="exp-bullets">
              <li>
                <p class="exp-group-label">Guided workflow creation</p>
                <p class="exp-group-text">
                  Built guided workflow creation with use-case templates, sequential click-to-add nodes,
                  and a MongoDB workflow-template schema, replacing blank-canvas setup with a structured starting point.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Workflow analytics</p>
                <p class="exp-group-text">
                  Built workflow analytics with Recharts visualizations, a Node.js backend, and a ClickHouse database layer, displaying metrics to the interface for monitoring workflow activity and performance.
                </p>
              </li>
              <li>
                <p class="exp-group-label">AI workflow configuration</p>
                <p class="exp-group-text">
                  Integrated AI workflow configuration by mapping natural-language requests to valid nodes
                  and using profile context to draft email-node content, supporting refinement through follow-up input.
                </p>
              </li>
              <li>
                <p class="exp-group-label">CRM &amp; campaign interfaces</p>
                <p class="exp-group-text">
                  Implemented React and TypeScript interfaces for contacts, leads, contact properties,
                  and email/WhatsApp campaign dashboards.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Launch &amp; production support</p>
                <p class="exp-group-text">
                  Diagnosed customer issues, shipped hotfixes, and supported deployments for the initial
                  release and two AppSumo campaigns. The first campaign onboarded 4,000+ users.
                </p>
              </li>
            </ul>
          </div>
          <div class="exp-product">
            <h4 class="exp-product-title">Swipe Pages</h4>
            <ul class="exp-bullets">
              <li>
                <p class="exp-group-label">Shared Template Library</p>
                <p class="exp-group-text">
                  Delivered the shared Landing Page/Funnel Template Library across frontend, backend,
                  and REST APIs, with screenshot browsing and iframe device previews. Loaded HTML
                  and builder data from S3-compatible storage on demand to initialize selected templates.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Reusable integrations</p>
                <p class="exp-group-text">
                  Refactored Workflow Builder integrations around shared configuration, property selection,
                  field mapping, and field-name matching while isolating provider-specific behavior.
                  Reused these patterns across SendFox, ActiveCampaign, AWeber, and other connectors,
                  reducing repeated mapping logic.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Cross-product infinite pagination</p>
                <p class="exp-group-text">
                  Built template/media infinite pagination across Swipe Pages and Swipe One with
                  IntersectionObserver and React Query request guards, appending pages without
                  overlapping requests and preserving loaded results during loading and errors.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Responsive builder controls</p>
                <p class="exp-group-text">
                  Contributed typography and named-color controls to the shared Landing Page/Funnel
                  builder, binding breakpoint-specific settings to an isolated iframe canvas so users
                  could adjust styles across device views.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Swipe Genie</p>
                <p class="exp-group-text">
                  Built the original Swipe Genie orchestration that routed business-specific answers to
                  asynchronous builder functions, preserving conversation context and limiting failed
                  executions to three attempts to support guided page generation.
                </p>
              </li>
            </ul>
          </div>
          <div class="exp-tech">
            {[
              'React',
              'Next.js',
              'TypeScript',
              'Tailwind CSS',
              'Redux',
              'React Query',
              'React Flow',
              'Recharts',
              'Ant Design',
              'Radix UI',
              'Node.js',
              'Express',
              'REST APIs',
              'Background Jobs',
              'Webhooks',
              'MongoDB',
              'ClickHouse',
              'Redis',
              'RabbitMQ',
              'DigitalOcean S3',
              'Vercel AI SDK',
              'LLM Integration',
              'Tool Calling',
              'Docker',
              'GitHub Actions',
              'CI/CD',
              'Sentry',
            ].map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </div>
      </article>

      <!-- Nexus -->
      <article class="exp-item reveal delay-100">
        <div class="exp-timeline-marker" aria-hidden="true"></div>
        <div class="exp-content">
          <div class="exp-header">
            <div>
              <h3 class="exp-title">Frontend Developer</h3>
              <p class="exp-company">
                Nexus Software Solutions
                <span class="exp-badge">UBMe</span>
              </p>
            </div>
            <p class="exp-period">Jun 2023 – Aug 2023</p>
          </div>
          <ul class="exp-bullets">
            <li>
              <p class="exp-group-label">Calendar &amp; timezone handling</p>
              <p class="exp-group-text">
                Built a reusable calendar wrapper that centralized styling and configuration.
                Implemented timezone-aware event and booking displays with Day.js and Moment.js,
                including UTC/local conversion and date changes across regions.
              </p>
            </li>
            <li>
              <p class="exp-group-label">React interfaces &amp; real-time features</p>
              <p class="exp-group-text">
                Built responsive React interfaces with hooks and Redux for client-facing applications,
                including UBMe, an event-management platform. Collaborated on WebSocket-based chat
                that displayed live messages without manual refresh.
              </p>
            </li>
            <li>
              <p class="exp-group-label">API integration</p>
              <p class="exp-group-text">
                Integrated REST APIs with Axios/Fetch and implemented CRUD interactions for booking
                and scheduling flows, collaborating with designers and engineers on reusable components
                and consistent interface behavior.
              </p>
            </li>
          </ul>
          <div class="exp-tech">
            {['React', 'MUI', 'Redux', 'WebSocket', 'JavaScript', 'Day.js', 'Moment.js', 'Axios'].map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </div>
      </article>

      <!-- Education -->
      <article class="exp-item reveal delay-200">
        <div class="exp-timeline-marker edu" aria-hidden="true"></div>
        <div class="exp-content">
          <h3 class="exp-title">Education</h3>
          <ul class="exp-edu-list">
            <li>
              <span class="exp-edu-name">Bosscoder Academy</span>
              <span class="exp-edu-detail">Advanced AI &amp; ML Engineering Program · Jun 2026 – present</span>
            </li>
            <li>
              <span class="exp-edu-name">Amity University</span>
              <span class="exp-edu-detail">BCA (Bachelor of Computer Applications) · Apr 2025 – present</span>
            </li>
            <li>
              <span class="exp-edu-name">Masai School</span>
              <span class="exp-edu-detail">Full Stack Web Development Bootcamp · 2022</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* Gradient background: alt-blend → canvas → alt-blend.
     Starts at the alt-blend shade (matching Skills' bottom), holds canvas
     through the middle, and ends at alt-blend again (matching Testimonials'
     top). Entirely solid colours — no transparency, no compositing jump. */
  .exp-bg {
    background: color-mix(in srgb, var(--color-surface) 40%, var(--color-canvas));
  }
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 2px 1fr;
    gap: 0 1.5rem;
    position: relative;
    padding-bottom: 2.5rem;
  }
  .exp-item:last-child {
    padding-bottom: 0;
  }

  .exp-timeline-marker {
    position: relative;
    background: var(--color-border);
  }
  .exp-timeline-marker::before {
    content: '';
    position: absolute;
    top: 0.375rem;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    background: var(--color-accent);
    border-radius: 50%;
    border: 3px solid var(--color-canvas);
  }
  .exp-timeline-marker.edu::before {
    background: var(--color-ink-dim);
    border: 3px solid var(--color-canvas);
  }

  .exp-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .exp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.125rem;
  }

  .exp-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.2rem;
    letter-spacing: -0.015em;
  }

  .exp-company {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exp-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-control);
    border: 0;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim);
    white-space: nowrap;
    margin: 0;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--glass-surface-border);
    border-radius: var(--radius-control);
    background: var(--glass-surface-bg);
  }

  .exp-product {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .exp-product + .exp-product {
    margin-top: 0.5rem;
  }
  .exp-product-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .exp-bullets li {
    max-width: 72ch;
    margin: 0;
  }
  .exp-group-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-text);
    margin: 0 0 0.25rem;
  }
  .exp-group-text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
    margin: 0;
    text-align: left;
    text-wrap: pretty;
  }

  .exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .exp-edu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .exp-edu-list li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .exp-edu-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .exp-edu-detail {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .exp-item {
      grid-template-columns: 1fr;
    }
    .exp-timeline-marker {
      display: none;
    }
    .exp-item {
      padding-bottom: 2rem;
    }
    .exp-item:last-child {
      border-bottom: none;
    }
  }
</style>
