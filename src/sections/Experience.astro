---
/**
 * R5-6 section partition: Experience (was part of index.astro).
 * Markup + scoped styles relocated verbatim from index.astro.
 */
import SectionHeader from '../components/SectionHeader.astro';
---

<section id="experience" class="section-block">
  <div class="container-site">
    <SectionHeader label="Experience" title="Where I've worked" />

    <div class="experience-list">
      <!-- Brand Exponents -->
      <article class="exp-item reveal">
        <div class="exp-timeline-marker" aria-hidden="true"></div>
        <div class="exp-content">
          <div class="exp-header">
            <div>
              <h3 class="exp-title">Full Stack Developer</h3>
              <p class="exp-company">
                Brand Exponents Creatives Pvt Ltd
                <span class="exp-badge">Swipe Pages · Swipe One</span>
              </p>
            </div>
            <p class="exp-period">Oct 2023 – Aug 2025</p>
          </div>
          <ul class="exp-bullets">
            <li>
              <p class="exp-group-label">Integrations</p>
              <p class="exp-group-text">
                Contributed to the Workflow Builder's integration layer on Swipe Pages: shared configuration, property selection, field-mapping, and auto-matching patterns reused across several providers, including SendFox, ActiveCampaign, AWeber, Moosend, Salesflare, and EngageBay.
              </p>
            </li>
            <li>
              <p class="exp-group-label">CRM</p>
              <p class="exp-group-text">
                Helped build Swipe One's CRM features, including contacts, leads, contact properties, and email & WhatsApp campaigns, and contributed to redesigning the workflow builder from blank-canvas drag-and-drop into a guided, template-led flow.
              </p>
            </li>
            <li>
              <p class="exp-group-label">AI-assisted features</p>
              <p class="exp-group-text">
                Contributed to AI-assisted features including natural-language workflow generation, an AI assistant that auto-configures workflow nodes and auto-drafts email nodes from the user's profile context, and the original Swipe Genie guided page-generation experience.
              </p>
            </li>
            <li>
              <p class="exp-group-label">Workflow builder &amp; analytics</p>
              <p class="exp-group-text">
                Contributed to workflow-related dashboards and reusable workflow templates on Swipe Pages, and helped build the Swipe One workflow-templates dashboard and workflow analytics so users could discover templates and monitor automation performance. Also contributed to shared page-builder systems including global responsive typography, named solid and gradient colour systems, and a responsive video module across landing pages and funnels.
              </p>
            </li>
            <li>
              <p class="exp-group-label">Platform, launches &amp; reliability</p>
              <p class="exp-group-text">
                Worked with background jobs, queues, and webhooks; contributed to the shared Template Library; built a reusable infinite-pagination system used across four product surfaces; and helped keep production stable through launches and debugging. Participated in two AppSumo launch periods, resolving customer queries, fixing live issues, shipping hotfixes, and iterating on product feedback across Discord, Facebook, and AppSumo.
              </p>
            </li>
          </ul>
          <div class="exp-tech">
            {['React', 'Next.js', 'TypeScript', 'Node.js', 'NestJS', 'PostgreSQL', 'Redis'].map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </div>
      </article>

      <!-- Nexus -->
      <article class="exp-item reveal delay-100">
        <div class="exp-timeline-marker" aria-hidden="true"></div>
        <div class="exp-content">
          <div class="exp-header">
            <div>
              <h3 class="exp-title">Frontend Developer Intern</h3>
              <p class="exp-company">
                Nexus Software Solutions
                <span class="exp-badge">UBMe</span>
              </p>
            </div>
            <p class="exp-period">Jun 2023 – Aug 2023</p>
          </div>
          <ul class="exp-bullets">
            <li>
              <p class="exp-group-label">Event-management product</p>
              <p class="exp-group-text">
                Contributed responsive React UI (hooks + Redux) and WebSocket real-time features for UBMe, an event-management product.
              </p>
            </li>
            <li>
              <p class="exp-group-label">Features &amp; integration</p>
              <p class="exp-group-text">
                Integrated APIs (Axios/Fetch) and implemented common CRUD interactions, and worked with designers and senior engineers on reusable components, UI libraries, and consistent interface patterns.
              </p>
            </li>
            <li>
              <p class="exp-group-label">Code quality</p>
              <p class="exp-group-text">
                Refactored existing frontend code for readability, maintainability, and performance.
              </p>
            </li>
          </ul>
          <div class="exp-tech">
            {['React', 'Redux', 'WebSocket', 'JavaScript'].map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </div>
      </article>

      <!-- Education -->
      <article class="exp-item reveal delay-200">
        <div class="exp-timeline-marker edu" aria-hidden="true"></div>
        <div class="exp-content">
          <h3 class="exp-title">Education</h3>
          <ul class="exp-edu-list">
            <li>
              <span class="exp-edu-name">Masai School</span>
              <span class="exp-edu-detail">Full Stack Web Development Bootcamp · 2022</span>
            </li>
            <li>
              <span class="exp-edu-name">Amity University</span>
              <span class="exp-edu-detail">BCA (Bachelor of Computer Applications) · 2025 – present</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 2px 1fr;
    gap: 0 1.5rem;
    position: relative;
    padding-bottom: 2.5rem;
  }
  .exp-item:last-child {
    padding-bottom: 0;
  }

  .exp-timeline-marker {
    position: relative;
    background: var(--color-border);
  }
  .exp-timeline-marker::before {
    content: '';
    position: absolute;
    top: 0.375rem;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    background: var(--color-accent);
    border-radius: 50%;
    border: 3px solid var(--color-canvas);
  }
  .exp-timeline-marker.edu::before {
    background: var(--color-ink-dim);
    border: 3px solid var(--color-canvas);
  }

  .exp-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .exp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exp-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.2rem;
    letter-spacing: -0.015em;
  }

  .exp-company {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exp-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--color-accent-soft);
    color: var(--color-accent-light);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-control);
    border: 0;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim);
    white-space: nowrap;
    margin: 0;
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .exp-bullets li {
    max-width: 72ch;
    margin: 0;
  }
  .exp-group-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-dim);
    margin: 0 0 0.25rem;
  }
  .exp-group-text {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-muted);
    margin: 0;
    text-align: justify;
    text-justify: inter-word;
    text-align-last: left;
  }

  .exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .exp-edu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .exp-edu-list li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .exp-edu-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .exp-edu-detail {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .exp-item {
      grid-template-columns: 1fr;
    }
    .exp-timeline-marker {
      display: none;
    }
    .exp-item {
      padding-bottom: 2rem;
    }
    .exp-item:last-child {
      border-bottom: none;
    }
  }
</style>