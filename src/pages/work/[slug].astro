---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';

// Case studies — one-to-one with the brief template (product-and-design-brief.md Part 2).
// Narrative copy source: docs/research/featured-project-research.md + evidence ledger.

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, roleLabel, period, status, summary, repo, demo, tech, cover } =
  entry.data;

// Cover image (owner-approved README screenshot, DL-011). Absent for projects whose
// README has no real screenshot (e.g. perplexity, lingo-agent) -> no cover rendered.
const covers = import.meta.glob('../../assets/work/*', {
  eager: true,
  import: 'default',
});
const coverSrc = cover ? covers[`../../assets/work/${cover}`] : undefined;
---

<Base title={`${title} — Kashif Rezwi`} description={summary}>
  <article class="container-site py-16 md:py-20">
    <!-- Header: name · role label (always visible) · period/status · links -->
    <header>
      <p class="section-label">{roleLabel}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
        {title}
      </h1>
      <p class="mt-2 font-mono text-sm text-ink-muted">
        {period} · {status}
      </p>
      <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1 font-mono text-sm">
        <a href={repo} class="link-accent">Repository</a>
        {demo && <a href={demo} class="link-accent">Live demo</a>}
        <a href={withBase('/#work')} class="link-accent">← Back to selected work</a>
      </p>
    </header>

    {
      coverSrc && (
        <figure class="mt-8">
          <Image
            src={coverSrc}
            alt={`${title} — screenshot from the project README`}
            width={1200}
            format="avif"
            quality={70}
            loading="lazy"
            class="rounded-md border border-hairline bg-surface"
          />
        </figure>
      )
    }

    <!-- Body: Overview / What I built / Challenges / Outcomes (brief template).
         The Challenges heading appears only where the content documents it. -->
    <div class="markdown mt-10">
      <Content />
    </div>

    <!-- Tech — text tags, not logos (brief) -->
    <section class="mt-10">
      <h2 class="font-mono text-sm text-ink-muted">Tech</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          tech.map((t) => (
            <li class="rounded bg-accent-soft px-2 py-0.5 font-mono text-xs text-accent-ink">
              {t}
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>