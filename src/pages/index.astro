---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import HeroDotMatrix from '../components/HeroDotMatrix.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.jpg';

const description =
  'Frontend-focused Full Stack Engineer with 2+ years building customer-facing SaaS products in startup teams — landing-page builders, CRM, and campaign & workflow automation. Currently building AI products and developer tools.';

const featured = (await getCollection('work'))
  .filter((e) => e.data.order <= 3)
  .sort((a, b) => a.data.order - b.data.order);

const links = {
  email: 'kashifrezwi850@gmail.com',
  github: 'https://github.com/Kashif-Rezwi',
  linkedin: 'https://www.linkedin.com/in/kashif-rezwi-149372216/',
  devto: 'https://dev.to/kashifrezwi',
  devtoArticle: 'https://dev.to/kashifrezwi/i-built-an-ai-agent-that-makes-any-nextjs-app-multilingual-in-3-minutes-4bdm',
  archive: 'https://github.com/Kashif-Rezwi?tab=repositories',
  betterDevUi: 'https://github.com/Kashif-Rezwi/better-dev-ui',
  betterDevApi: 'https://github.com/Kashif-Rezwi/better-dev-api',
  betterDevDemo: 'https://betterdev.in',
  looplens: 'https://github.com/Kashif-Rezwi/looplens',
  looplensDemo: 'https://looplens-rho.vercel.app',
  aiPlayground: 'https://github.com/Kashif-Rezwi/ai-playground',
  languagePlayground: 'https://github.com/Kashif-Rezwi/language-playground',
};

// Tech stack data (from skills-inventory.md)
const techStack = [
  {
    category: 'Languages',
    items: ['JavaScript', 'TypeScript', 'Python'],
  },
  {
    category: 'Frontend',
    items: ['React', 'Next.js', 'Tailwind CSS', 'Redux', 'TanStack Query'],
  },
  {
    category: 'Backend',
    items: ['Node.js', 'Express', 'NestJS', 'WebSockets', 'REST APIs'],
  },
  {
    category: 'Databases & Infra',
    items: ['PostgreSQL', 'MongoDB', 'Redis', 'Docker', 'GitHub Actions'],
  },
  {
    category: 'AI & Tools',
    items: ['Vercel AI SDK', 'LangChain', 'BullMQ', 'Prisma', 'pgvector'],
  },
];
---

<Base
  title="Kashif Rezwi — Frontend-focused Full Stack Engineer"
  description={description}
>
  <!-- ================================================================
       HERO
  ================================================================ -->
  <section class="hero-section">
    <HeroDotMatrix />
    <div class="container-site hero-inner">
      <div class="hero-content animate-fade-up">
        <!-- Label -->
        <p class="section-label delay-100 animate-fade-up">Portfolio</p>

        <!-- Headline -->
        <h1 class="hero-name delay-200 animate-fade-up">
          Kashif<br />Rezwi
        </h1>

        <!-- Sub-headline with gradient -->
        <p class="hero-role delay-300 animate-fade-up">
          <span class="gradient-text">Building toward AI product engineering</span><br />
          and developer tools
        </p>

        <!-- Bio -->
        <p class="hero-bio delay-400 animate-fade-up">
          2+ years building customer-facing SaaS products in startup teams —
          landing-page builders, CRM, and campaign & workflow automation.
          Currently building AI products and developer tools.
        </p>

        <!-- CTA row -->
        <div class="hero-ctas delay-500 animate-fade-up">
          <a href={withBase('resume/')} class="btn">View Resume</a>
          <a href={`mailto:${links.email}`} class="btn-outline">Email me</a>
          <div class="hero-social-links">
            <a href={links.github} class="hero-social" target="_blank" rel="noopener noreferrer"><Icon name="github" size={15} />GitHub</a>
            <a href={links.linkedin} class="hero-social" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={15} />LinkedIn</a>
            <a href={links.devto} class="hero-social" target="_blank" rel="noopener noreferrer"><Icon name="devto" size={15} />dev.to</a>
          </div>
        </div>
      </div>

      <!-- Portrait -->
      <div class="hero-portrait delay-300 animate-fade-up">
        <div class="portrait-wrapper">
          <div class="portrait-glow" aria-hidden="true"></div>
          <Image
            src={portrait}
            alt="Portrait of Kashif Rezwi"
            width={320}
            height={320}
            format="avif"
            quality={70}
            loading="eager"
            fetchpriority="high"
            class="portrait-img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       SELECTED WORK
  ================================================================ -->
  <section id="work" class="section-block">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Selected work</p>
        <h2 class="section-title">Things I've built</h2>
        <p class="section-subtitle">
          AI products and developer tools — personal projects with live demos.
        </p>
      </div>

      <div class="work-grid">
        {featured.map((entry, i) => (
          <div class={`reveal delay-${(i + 1) * 100}`}>
            <WorkCard
              title={entry.data.title}
              roleLabel={entry.data.roleLabel}
              period={entry.data.period}
              status={entry.data.status}
              summary={entry.data.summary}
              repo={entry.data.repo}
              demo={entry.data.demo}
              tech={entry.data.tech}
              href={withBase(`work/${entry.id}/`)}
              cover={entry.data.cover}
            />
          </div>
        ))}
      </div>

      <!-- More projects compact list -->
      <div class="more-projects reveal">
        <h3 class="more-projects-label">More projects</h3>
        <ul class="more-projects-list">
          <li class="more-project-item">
            <div class="more-project-header">
              <span class="more-project-name">Better DEV</span>
              <span class="more-project-type">Personal</span>
            </div>
            <p class="more-project-desc">
              AI chat platform with streaming UI, visible tool calls, NestJS API with JWT auth and web search integration.
            </p>
            <div class="more-project-links">
              <a href={links.betterDevUi} class="link-accent" target="_blank" rel="noopener noreferrer">UI repo</a>
              <a href={links.betterDevApi} class="link-accent" target="_blank" rel="noopener noreferrer">API repo</a>
              <a href={links.betterDevDemo} class="link-accent" target="_blank" rel="noopener noreferrer">Live</a>
            </div>
          </li>
          <li class="more-project-item">
            <div class="more-project-header">
              <span class="more-project-name">LoopLens</span>
              <span class="more-project-type">Hackathon · TestSprite S3</span>
            </div>
            <p class="more-project-desc">
              Proof-of-work dashboard that turns AI-coding-loop evidence into a shareable engineering timeline.
            </p>
            <div class="more-project-links">
              <a href={links.looplens} class="link-accent" target="_blank" rel="noopener noreferrer">Repo</a>
              <a href={links.looplensDemo} class="link-accent" target="_blank" rel="noopener noreferrer">Live</a>
            </div>
          </li>
          <li class="more-project-item">
            <div class="more-project-header">
              <span class="more-project-name">Learning in public</span>
              <span class="more-project-type">Open repos</span>
            </div>
            <p class="more-project-desc">
              <a href={links.aiPlayground} class="link-accent" target="_blank" rel="noopener noreferrer">ai-playground</a> and{' '}
              <a href={links.languagePlayground} class="link-accent" target="_blank" rel="noopener noreferrer">language-playground</a>
              — open experiments and notes.
            </p>
            <div class="more-project-links">
              <a href={links.archive} class="link-accent" target="_blank" rel="noopener noreferrer">Full archive →</a>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================================================================
       TECH STACK
  ================================================================ -->
  <section id="skills" class="section-block section-alt">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Tech stack</p>
        <h2 class="section-title">What I work with</h2>
      </div>
      <div class="tech-grid">
        {techStack.map((group, i) => (
          <div class={`tech-group reveal delay-${(i + 1) * 100}`}>
            <h3 class="tech-group-label">{group.category}</h3>
            <ul class="tech-group-items" role="list">
              {group.items.map((item) => (
                <li class="tech-item">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================
       EXPERIENCE
  ================================================================ -->
  <section id="experience" class="section-block">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Experience</p>
        <h2 class="section-title">Where I've worked</h2>
      </div>

      <div class="experience-list">
        <!-- Brand Exponents -->
        <article class="exp-item reveal">
          <div class="exp-timeline-marker" aria-hidden="true"></div>
          <div class="exp-content">
            <div class="exp-header">
              <div>
                <h3 class="exp-title">Full Stack Developer</h3>
                <p class="exp-company">
                  Brand Exponents Creatives Pvt Ltd
                  <span class="exp-badge">Swipe Pages · Swipe One</span>
                </p>
              </div>
              <p class="exp-period">Oct 2023 – Aug 2025</p>
            </div>
            <ul class="exp-bullets">
              <li>
                Contributed to the Workflow Builder's integration layer on Swipe Pages — shared configuration, property selection, field-mapping, and auto-matching patterns reused across six providers: SendFox, ActiveCampaign, AWeber, Moosend, Salesflare, and EngageBay.
              </li>
              <li>
                Helped build Swipe One's CRM features — contacts, leads, contact properties, and email & WhatsApp campaigns — and contributed to redesigning the workflow builder from blank-canvas drag-and-drop into a guided, template-led flow.
              </li>
              <li>
                Contributed to AI-assisted features including natural-language workflow generation and the original Swipe Genie guided page-generation experience.
              </li>
              <li>
                Worked with background jobs, queues, and webhooks; contributed to the shared Template Library; built a reusable infinite-pagination system used across four product surfaces; helped keep production stable through launches and debugging.
              </li>
            </ul>
            <div class="exp-tech">
              {['React', 'Next.js', 'TypeScript', 'Node.js', 'NestJS', 'PostgreSQL', 'Redis'].map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
          </div>
        </article>

        <!-- Nexus -->
        <article class="exp-item reveal delay-100">
          <div class="exp-timeline-marker" aria-hidden="true"></div>
          <div class="exp-content">
            <div class="exp-header">
              <div>
                <h3 class="exp-title">Frontend Developer Intern</h3>
                <p class="exp-company">
                  Nexus Software Solutions
                  <span class="exp-badge">UBMe</span>
                </p>
              </div>
              <p class="exp-period">Jun 2023 – Aug 2023</p>
            </div>
            <p class="exp-summary">
              Contributed responsive React UI (hooks + Redux) and WebSocket real-time features for UBMe, an event-management product.
            </p>
            <div class="exp-tech">
              {['React', 'Redux', 'WebSocket', 'JavaScript'].map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
          </div>
        </article>

        <!-- Education -->
        <article class="exp-item reveal delay-200">
          <div class="exp-timeline-marker edu" aria-hidden="true"></div>
          <div class="exp-content">
            <h3 class="exp-title">Education</h3>
            <ul class="exp-edu-list">
              <li>
                <span class="exp-edu-name">Masai School</span>
                <span class="exp-edu-detail">Full Stack Web Development Bootcamp · 2022</span>
              </li>
              <li>
                <span class="exp-edu-name">Amity University</span>
                <span class="exp-edu-detail">BCA (Bachelor of Computer Applications) · 2025 – present</span>
              </li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ================================================================
       AI JOURNEY / NOW
  ================================================================ -->
  <section id="now" class="section-block section-alt">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Now</p>
        <h2 class="section-title">AI journey</h2>
      </div>

      <div class="now-grid">
        <div class="now-card reveal">
          <div class="now-card-icon"><Icon name="sparkles" size={20} /></div>
          <h3 class="now-card-title">Building</h3>
          <p class="now-card-desc">
            I'm building toward AI product engineering and developer tools. Recent personal projects include an AI code-review agent, a cited AI answer engine, and an autonomous i18n agent.
          </p>
        </div>
        <div class="now-card reveal delay-100">
          <div class="now-card-icon"><Icon name="writing" size={20} /></div>
          <h3 class="now-card-title">Writing</h3>
          <p class="now-card-desc">
            I write about what I build. The <a href={links.devtoArticle} class="link-accent" target="_blank" rel="noopener noreferrer">LingoAgent article on dev.to</a> walks through that build.
          </p>
        </div>
        <div class="now-card reveal delay-200">
          <div class="now-card-icon"><Icon name="learning" size={20} /></div>
          <h3 class="now-card-title">Learning in public</h3>
          <p class="now-card-desc">
            <a href={links.aiPlayground} class="link-accent" target="_blank" rel="noopener noreferrer">ai-playground</a> and <a href={links.languagePlayground} class="link-accent" target="_blank" rel="noopener noreferrer">language-playground</a> — open repos of experiments, notes, and rough edges.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       CONTACT
  ================================================================ -->
  <section id="contact" class="section-block contact-section">
    <div class="container-site">
      <div class="contact-inner reveal">
        <p class="section-label">Contact</p>
        <h2 class="contact-heading">
          Let's build something<br />
          <span class="gradient-text">worth shipping.</span>
        </h2>
        <p class="contact-sub">
          For freelance projects and conversations, reach me by email or phone, or find me on GitHub, LinkedIn, and dev.to.
        </p>
        <div class="contact-ctas">
          <a href={`mailto:${links.email}`} class="btn">
            Send an email →
          </a>
          <span class="contact-email-plain">
            {links.email}
          </span>
        </div>
        <div class="contact-links">
          <a href={links.github} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} />GitHub</a>
          <a href={links.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={16} />LinkedIn</a>
          <a href={links.devto} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="devto" size={16} />dev.to</a>
          <a href={`tel:9883909187`} class="contact-link"><Icon name="phone" size={16} />+91 98839 09187</a>
          <span class="contact-location"><Icon name="location" size={16} />Kolkata, India</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----------------------------------------------------------------
     Hero
  ---------------------------------------------------------------- */
  .hero-section {
    min-height: clamp(600px, calc(100svh - 65px), 860px);
    padding-block: 5rem 4rem;
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-section::before {
    /* Subtle radial glow behind content */
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 0%, var(--color-accent-glow), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-name {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-role {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    max-width: 58ch;
    margin: 0;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 0.25rem;
  }
  .hero-social {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .hero-social:hover {
    color: var(--color-accent-light);
  }

  /* Portrait */
  .hero-portrait {
    flex-shrink: 0;
  }
  .portrait-wrapper {
    position: relative;
    width: 220px;
    height: 220px;
  }
  .portrait-glow {
    position: absolute;
    inset: -12px;
    background: var(--gradient-accent);
    border-radius: 50%;
    opacity: 0.25;
    filter: blur(20px);
    z-index: 0;
  }
  .portrait-img {
    position: relative;
    z-index: 1;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
  }

  /* ----------------------------------------------------------------
     Section scaffolding
  ---------------------------------------------------------------- */
  .section-block {
    padding-block: 5rem;
  }

  .section-alt {
    background: color-mix(in srgb, var(--color-surface) 40%, transparent);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0.375rem 0 0;
    color: var(--color-ink);
  }

  .section-subtitle {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    max-width: 56ch;
  }

  /* ----------------------------------------------------------------
     Work grid
  ---------------------------------------------------------------- */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  /* ----------------------------------------------------------------
     More projects
  ---------------------------------------------------------------- */
  .more-projects {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
  .more-projects-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .more-projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .more-project-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .more-project-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .more-project-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .more-project-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }
  .more-project-type {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-dim);
  }
  .more-project-desc {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    max-width: 72ch;
    margin: 0;
  }
  .more-project-links {
    display: flex;
    gap: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* ----------------------------------------------------------------
     Tech stack
  ---------------------------------------------------------------- */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .tech-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tech-group-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: 500;
    margin: 0;
  }
  .tech-group-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tech-item {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    background: var(--color-surface);
    border: 0;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-control);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    cursor: default;
  }
  .tech-item:hover {
    color: var(--color-accent-text);
    background: var(--color-accent-soft);
  }

  /* ----------------------------------------------------------------
     Experience
  ---------------------------------------------------------------- */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 2px 1fr;
    gap: 0 1.5rem;
    position: relative;
    padding-bottom: 2.5rem;
  }
  .exp-item:last-child {
    padding-bottom: 0;
  }

  .exp-timeline-marker {
    position: relative;
    background: var(--color-border);
  }
  .exp-timeline-marker::before {
    content: '';
    position: absolute;
    top: 0.375rem;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    background: var(--color-accent);
    border-radius: 50%;
    border: 3px solid var(--color-canvas);
  }
  .exp-timeline-marker.edu::before {
    background: var(--color-ink-dim);
    border: 3px solid var(--color-canvas);
  }

  .exp-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .exp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exp-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.2rem;
    letter-spacing: -0.015em;
  }

  .exp-company {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exp-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--color-accent-soft);
    color: var(--color-accent-light);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-control);
    border: 0;
  }

  .exp-period {
