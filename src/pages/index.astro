---
// R5-6: home page is now a thin composition — data is gathered here and handed
// to the section components in src/sections/* (each owns its scoped styles).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import Work from '../sections/Work.astro';
import Skills from '../sections/Skills.astro';
import Experience from '../sections/Experience.astro';
import Testimonials from '../sections/Testimonials.astro';
import Now from '../sections/Now.astro';
import Contact from '../sections/Contact.astro';
import portrait from '../assets/portrait.jpg';

const description =
  'Frontend-focused Full Stack Engineer with 2+ years building customer-facing SaaS products in startup teams: landing-page builders, CRM, and campaign & workflow automation. Currently building AI products and developer tools.';

const featured = (await getCollection('work'))
  .filter((e) => e.data.order <= 3)
  .sort((a, b) => a.data.order - b.data.order);

const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);

const links = {
  email: 'kashifrezwi850@gmail.com',
  github: 'https://github.com/Kashif-Rezwi',
  linkedin: 'https://www.linkedin.com/in/kashif-rezwi-149372216/',
  devto: 'https://dev.to/kashifrezwi',
  devtoArticle: 'https://dev.to/kashifrezwi/i-built-an-ai-agent-that-makes-any-nextjs-app-multilingual-in-3-minutes-4bdm',
  archive: 'https://github.com/Kashif-Rezwi?tab=repositories',
  betterDevUi: 'https://github.com/Kashif-Rezwi/better-dev-ui',
  betterDevApi: 'https://github.com/Kashif-Rezwi/better-dev-api',
  betterDevDemo: 'https://betterdev.in',
  looplens: 'https://github.com/Kashif-Rezwi/looplens',
  looplensDemo: 'https://looplens-rho.vercel.app',
  aiPlayground: 'https://github.com/Kashif-Rezwi/ai-playground',
  languagePlayground: 'https://github.com/Kashif-Rezwi/language-playground',
};

// Tech stack data (from skills-inventory.md)
const techStack = [
  {
    category: 'Languages',
    items: [
      { name: 'JavaScript', color: '#F7DF1E', icon: 'javascript' },
      { name: 'TypeScript', color: '#3178C6', icon: 'typescript' },
      { name: 'Python', color: '#3776AB', icon: 'python' },
    ],
  },
  {
    category: 'Frontend',
    items: [
      { name: 'React', color: '#61DAFB', icon: 'react' },
      { name: 'Next.js', color: '#000000', colorLight: '#ffffff', icon: 'nextdotjs' },
      { name: 'Tailwind CSS', color: '#06B6D4', icon: 'tailwindcss' },
      { name: 'Redux', color: '#764ABC', icon: 'redux' },
      { name: 'TanStack Query', color: '#FF4154', icon: 'reactquery' },
    ],
  },
  {
    category: 'Backend',
    items: [
      { name: 'Node.js', color: '#5FA04E', icon: 'nodedotjs' },
      { name: 'Express', color: '#0A0A0A', colorLight: '#ffffff', icon: 'express' },
      { name: 'REST APIs', color: '#58a6ff', icon: 'rest' },
      { name: 'NestJS', color: '#E0234E', icon: 'nestjs' },
      { name: 'WebSockets', color: '#58a6ff', icon: 'websocket' },
      { name: 'RabbitMQ', color: '#FF6600', icon: 'rabbitmq' },
    ],
  },
  {
    category: 'Databases & Infra',
    items: [
      { name: 'PostgreSQL', color: '#4169E1', icon: 'postgresql' },
      { name: 'MongoDB', color: '#47A248', icon: 'mongodb' },
      { name: 'ClickHouse', color: '#FFCC01', icon: 'clickhouse' },
      { name: 'Redis', color: '#FF4438', icon: 'redis' },
      { name: 'Docker', color: '#2496ED', icon: 'docker' },
      { name: 'Git', color: '#F03C2E', icon: 'git' },
      { name: 'GitHub Actions', color: '#2088FF', icon: 'githubactions' },
    ],
  },
  {
    category: 'AI & Tools',
    items: [
{ name: 'Vercel AI SDK', color: '#000000', colorLight: '#ffffff', icon: 'vercel' },
      { name: 'Prisma', color: '#2D3748', colorLight: '#D3D9E0', icon: 'prisma' },
      { name: 'pgvector', color: '#7b61ff', icon: 'pgvector' },
      { name: 'BullMQ', color: '#e0234e', icon: 'bullmq' },
    ],
  },
];
---

<Base
    title="Kashif Rezwi · Portfolio",
  description={description}
>
  <Hero email={links.email} github={links.github} linkedin={links.linkedin} devto={links.devto} portrait={portrait} />
  <Work featured={featured} links={links} />
  <Skills techStack={techStack} />
  <Experience />
  <Testimonials testimonials={testimonials} />
  <Now links={links} />
  <Contact links={links} />
</Base>