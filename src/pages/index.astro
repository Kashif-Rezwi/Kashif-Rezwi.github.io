---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import GitHubContributions from '../components/GitHubContributions.astro';
import HeroDotMatrix from '../components/HeroDotMatrix.astro';
import Icon from '../components/Icon.astro';
import TechIcon from '../components/TechIcon.astro';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.jpg';

const description =
  'Frontend-focused Full Stack Engineer with 2+ years building customer-facing SaaS products in startup teams: landing-page builders, CRM, and campaign & workflow automation. Currently building AI products and developer tools.';

const featured = (await getCollection('work'))
  .filter((e) => e.data.order <= 3)
  .sort((a, b) => a.data.order - b.data.order);

const links = {
  email: 'kashifrezwi850@gmail.com',
  github: 'https://github.com/Kashif-Rezwi',
  linkedin: 'https://www.linkedin.com/in/kashif-rezwi-149372216/',
  devto: 'https://dev.to/kashifrezwi',
  devtoArticle: 'https://dev.to/kashifrezwi/i-built-an-ai-agent-that-makes-any-nextjs-app-multilingual-in-3-minutes-4bdm',
  archive: 'https://github.com/Kashif-Rezwi?tab=repositories',
  betterDevUi: 'https://github.com/Kashif-Rezwi/better-dev-ui',
  betterDevApi: 'https://github.com/Kashif-Rezwi/better-dev-api',
  betterDevDemo: 'https://betterdev.in',
  looplens: 'https://github.com/Kashif-Rezwi/looplens',
  looplensDemo: 'https://looplens-rho.vercel.app',
  aiPlayground: 'https://github.com/Kashif-Rezwi/ai-playground',
  languagePlayground: 'https://github.com/Kashif-Rezwi/language-playground',
};

// Tech stack data (from skills-inventory.md)
const techStack = [
  {
    category: 'Languages',
    items: [
      { name: 'JavaScript', color: '#F7DF1E', icon: 'javascript' },
      { name: 'TypeScript', color: '#3178C6', icon: 'typescript' },
      { name: 'Python', color: '#3776AB', icon: 'python' },
    ],
  },
  {
    category: 'Frontend',
    items: [
      { name: 'React', color: '#61DAFB', icon: 'react' },
      { name: 'Next.js', color: '#000000', colorLight: '#ffffff', icon: 'nextdotjs' },
      { name: 'Tailwind CSS', color: '#06B6D4', icon: 'tailwindcss' },
      { name: 'Redux', color: '#764ABC', icon: 'redux' },
      { name: 'TanStack Query', color: '#FF4154', icon: 'reactquery' },
    ],
  },
  {
    category: 'Backend',
    items: [
      { name: 'Node.js', color: '#5FA04E', icon: 'nodedotjs' },
      { name: 'Express', color: '#0A0A0A', colorLight: '#ffffff', icon: 'express' },
      { name: 'REST APIs', color: '#58a6ff', icon: 'rest' },
      { name: 'NestJS', color: '#E0234E', icon: 'nestjs' },
      { name: 'WebSockets', color: '#58a6ff', icon: 'websocket' },
      { name: 'RabbitMQ', color: '#FF6600', icon: 'rabbitmq' },
    ],
  },
  {
    category: 'Databases & Infra',
    items: [
      { name: 'PostgreSQL', color: '#4169E1', icon: 'postgresql' },
      { name: 'MongoDB', color: '#47A248', icon: 'mongodb' },
      { name: 'ClickHouse', color: '#FFCC01', icon: 'clickhouse' },
      { name: 'Redis', color: '#FF4438', icon: 'redis' },
      { name: 'Docker', color: '#2496ED', icon: 'docker' },
      { name: 'Git', color: '#F03C2E', icon: 'git' },
      { name: 'GitHub Actions', color: '#2088FF', icon: 'githubactions' },
    ],
  },
  {
    category: 'AI & Tools',
    items: [
{ name: 'Vercel AI SDK', color: '#000000', colorLight: '#ffffff', icon: 'vercel' },
      { name: 'Prisma', color: '#2D3748', colorLight: '#D3D9E0', icon: 'prisma' },
      { name: 'pgvector', color: '#7b61ff', icon: 'pgvector' },
      { name: 'BullMQ', color: '#e0234e', icon: 'bullmq' },
    ],
  },
];
---

<Base
  title="Kashif Rezwi · Frontend-focused Full Stack Engineer"
  description={description}
>
  <!-- ================================================================
       HERO
  ================================================================ -->
  <section class="hero-section">
    <HeroDotMatrix />
    <div class="container-site hero-inner">
      <div class="hero-content animate-fade-up">
        <!-- Label -->
        <p class="section-label delay-100 animate-fade-up">Portfolio</p>

        <!-- Name — single line -->
        <h1 class="hero-name delay-200 animate-fade-up">
          Kashif Rezwi
        </h1>

        <!-- Role line (consistent with title/meta/positioning) — skewed accent badge -->
        <p class="hero-role delay-300 animate-fade-up">
          <span class="hero-role-badge">
            <span class="hero-role-text-inner">Frontend-focused Full Stack Engineer</span>
          </span>
        </p>

        <!-- Direction — old deployed accent style restored -->
        <p class="hero-direction delay-350 animate-fade-up">
          <span class="gradient-text">Building toward AI product engineering</span>
          <br />
          and developer tools
        </p>

        <!-- Bio -->
        <p class="hero-bio delay-400 animate-fade-up">
          2+ years building customer-facing SaaS products in startup teams:
          landing-page builders, CRM, and campaign &amp; workflow automation.
          Currently building AI products and developer tools.
        </p>

        <!-- CTA row -->
        <div class="hero-ctas delay-500 animate-fade-up">
          <a href={withBase('resume/')} class="btn">View Resume</a>
          <a href={`mailto:${links.email}`} class="btn-outline">Email me</a>
          <div class="hero-social-links">
            <a href={links.github} class="hero-social" target="_blank" rel="noopener noreferrer"><Icon name="github" size={15} />GitHub</a>
            <a href={links.linkedin} class="hero-social" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={15} />LinkedIn</a>
            <a href={links.devto} class="hero-social" target="_blank" rel="noopener noreferrer"><Icon name="devto" size={15} />dev.to</a>
          </div>
        </div>
      </div>

      <!-- Portrait -->
      <div class="hero-portrait delay-300 animate-fade-up">
        <div class="portrait-wrapper">
          <Image
            src={portrait}
            alt="Portrait of Kashif Rezwi"
            width={320}
            height={320}
            format="avif"
            quality={70}
            loading="eager"
            fetchpriority="high"
            class="portrait-img"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       SELECTED WORK
  ================================================================ -->
  <section id="work" class="section-block">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Selected work</p>
        <h2 class="section-title">Things I've built</h2>
        <p class="section-subtitle">
          AI products and developer tools, built as personal projects with live demos.
        </p>
      </div>

      <div class="work-grid">
        {featured.map((entry, i) => (
          <div class={`reveal delay-${(i + 1) * 100}`}>
            <WorkCard
              title={entry.data.title}
              roleLabel={entry.data.roleLabel}
              period={entry.data.period}
              status={entry.data.status}
              summary={entry.data.summary}
              repo={entry.data.repo}
              demo={entry.data.demo}
              tech={entry.data.tech}
              href={withBase(`work/${entry.id}/`)}
              cover={entry.data.cover}
            />
          </div>
        ))}
      </div>

      <!-- More projects compact list -->
      <div class="more-projects reveal">
        <h3 class="more-projects-label">More projects</h3>
        <ul class="more-projects-list">
          <ProjectRow
            name="Better DEV"
            typeLabel="Personal"
            links={[
              { href: links.betterDevUi, label: 'UI repo', icon: 'repository' },
              { href: links.betterDevApi, label: 'API repo', icon: 'repository' },
              { href: links.betterDevDemo, label: 'Live', icon: 'external' },
            ]}
          >
            AI chat platform with streaming UI, visible tool calls, NestJS API with JWT auth and web search integration.
          </ProjectRow>
          <ProjectRow
            name="LoopLens"
            typeLabel="Hackathon · TestSprite S3"
            links={[
              { href: links.looplens, label: 'Repo', icon: 'repository' },
              { href: links.looplensDemo, label: 'Live', icon: 'external' },
            ]}
          >
            Proof-of-work dashboard that turns AI-coding-loop evidence into a shareable engineering timeline.
          </ProjectRow>
          <ProjectRow
            name="Learning in public"
            typeLabel="Open repos"
            links={[{ href: links.archive, label: 'Full archive →', icon: 'repository' }]}
          >
            <a href={links.aiPlayground} class="link-accent" target="_blank" rel="noopener noreferrer">ai-playground</a> and{' '}
            <a href={links.languagePlayground} class="link-accent" target="_blank" rel="noopener noreferrer">language-playground</a>
            are open experiments and notes.
          </ProjectRow>
        </ul>
      </div>

      <!-- Public GitHub contribution calendar (build-time snapshot, local SVG) -->
      <GitHubContributions />
    </div>
  </section>

  <!-- ================================================================
       TECH STACK
  ================================================================ -->
  <section id="skills" class="section-block section-alt">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Tech stack</p>
        <h2 class="section-title">What I work with</h2>
      </div>
      <div class="tech-grid">
        {techStack.map((group, i) => (
          <div class={`tech-group reveal delay-${(i + 1) * 100}`}>
            <h3 class="tech-group-label">{group.category}</h3>
            <ul class="tech-group-items" role="list">
              {group.items.map((item) => (
                <li
                  class="tech-item"
                  style={`--brand: ${item.color}; --brand-on-dark: ${item.colorLight || item.color}`}
                >
                  {item.icon && <TechIcon name={item.icon} size={14} />}
                  {item.name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================
       EXPERIENCE
  ================================================================ -->
  <section id="experience" class="section-block">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Experience</p>
        <h2 class="section-title">Where I've worked</h2>
      </div>

      <div class="experience-list">
        <!-- Brand Exponents -->
        <article class="exp-item reveal">
          <div class="exp-timeline-marker" aria-hidden="true"></div>
          <div class="exp-content">
            <div class="exp-header">
              <div>
                <h3 class="exp-title">Full Stack Developer</h3>
                <p class="exp-company">
                  Brand Exponents Creatives Pvt Ltd
                  <span class="exp-badge">Swipe Pages · Swipe One</span>
                </p>
              </div>
              <p class="exp-period">Oct 2023 – Aug 2025</p>
            </div>
            <ul class="exp-bullets">
              <li>
                <p class="exp-group-label">Integrations</p>
                <p class="exp-group-text">
                  Contributed to the Workflow Builder's integration layer on Swipe Pages: shared configuration, property selection, field-mapping, and auto-matching patterns reused across several providers, including SendFox, ActiveCampaign, AWeber, Moosend, Salesflare, and EngageBay.
                </p>
              </li>
              <li>
                <p class="exp-group-label">CRM</p>
                <p class="exp-group-text">
                  Helped build Swipe One's CRM features, including contacts, leads, contact properties, and email & WhatsApp campaigns, and contributed to redesigning the workflow builder from blank-canvas drag-and-drop into a guided, template-led flow.
                </p>
              </li>
              <li>
                <p class="exp-group-label">AI-assisted features</p>
                <p class="exp-group-text">
                  Contributed to AI-assisted features including natural-language workflow generation, an AI assistant that auto-configures workflow nodes and auto-drafts email nodes from the user's profile context, and the original Swipe Genie guided page-generation experience.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Workflow builder &amp; analytics</p>
                <p class="exp-group-text">
                  Contributed to workflow-related dashboards and reusable workflow templates on Swipe Pages, and helped build the Swipe One workflow-templates dashboard and workflow analytics so users could discover templates and monitor automation performance. Also contributed to shared page-builder systems including global responsive typography, named solid and gradient colour systems, and a responsive video module across landing pages and funnels.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Platform, launches &amp; reliability</p>
                <p class="exp-group-text">
                  Worked with background jobs, queues, and webhooks; contributed to the shared Template Library; built a reusable infinite-pagination system used across four product surfaces; and helped keep production stable through launches and debugging. Participated in two AppSumo launch periods, resolving customer queries, fixing live issues, shipping hotfixes, and iterating on product feedback across Discord, Facebook, and AppSumo.
                </p>
              </li>
            </ul>
            <div class="exp-tech">
              {['React', 'Next.js', 'TypeScript', 'Node.js', 'NestJS', 'PostgreSQL', 'Redis'].map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
          </div>
        </article>

        <!-- Nexus -->
        <article class="exp-item reveal delay-100">
          <div class="exp-timeline-marker" aria-hidden="true"></div>
          <div class="exp-content">
            <div class="exp-header">
              <div>
                <h3 class="exp-title">Frontend Developer Intern</h3>
                <p class="exp-company">
                  Nexus Software Solutions
                  <span class="exp-badge">UBMe</span>
                </p>
              </div>
              <p class="exp-period">Jun 2023 – Aug 2023</p>
            </div>
            <ul class="exp-bullets">
              <li>
                <p class="exp-group-label">Event-management product</p>
                <p class="exp-group-text">
                  Contributed responsive React UI (hooks + Redux) and WebSocket real-time features for UBMe, an event-management product.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Features &amp; integration</p>
                <p class="exp-group-text">
                  Integrated APIs (Axios/Fetch) and implemented common CRUD interactions, and worked with designers and senior engineers on reusable components, UI libraries, and consistent interface patterns.
                </p>
              </li>
              <li>
                <p class="exp-group-label">Code quality</p>
                <p class="exp-group-text">
                  Refactored existing frontend code for readability, maintainability, and performance.
                </p>
              </li>
            </ul>
            <div class="exp-tech">
              {['React', 'Redux', 'WebSocket', 'JavaScript'].map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
          </div>
        </article>

        <!-- Education -->
        <article class="exp-item reveal delay-200">
          <div class="exp-timeline-marker edu" aria-hidden="true"></div>
          <div class="exp-content">
            <h3 class="exp-title">Education</h3>
            <ul class="exp-edu-list">
              <li>
                <span class="exp-edu-name">Masai School</span>
                <span class="exp-edu-detail">Full Stack Web Development Bootcamp · 2022</span>
              </li>
              <li>
                <span class="exp-edu-name">Amity University</span>
                <span class="exp-edu-detail">BCA (Bachelor of Computer Applications) · 2025 – present</span>
              </li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ================================================================
       AI JOURNEY / NOW
  ================================================================ -->
  <section id="now" class="section-block section-alt">
    <div class="container-site">
      <div class="section-header reveal">
        <p class="section-label">Now</p>
        <h2 class="section-title">AI journey</h2>
      </div>

      <div class="now-list">
        <div class="now-row reveal">
          <span class="now-row-icon"><Icon name="sparkles" size={17} /></span>
          <div class="now-row-body">
            <h3 class="now-row-title">Building</h3>
            <p class="now-row-desc">
              Toward AI product engineering and developer tools. Recent personal projects include an AI code-review agent, a cited AI answer engine, and an autonomous i18n agent. <a href="#work" class="link-accent">See the work →</a>
            </p>
          </div>
        </div>
        <div class="now-row reveal delay-100">
          <span class="now-row-icon"><Icon name="writing" size={17} /></span>
          <div class="now-row-body">
            <h3 class="now-row-title">Writing</h3>
            <p class="now-row-desc">
              <a href={links.devtoArticle} class="link-accent" target="_blank" rel="noopener noreferrer">I Built an AI Agent That Makes Any Landing Page (Next.js App) Multilingual in Minutes</a>
              <span class="now-row-meta">· LingoAgent build walkthrough on dev.to · Feb 2026</span>
            </p>
          </div>
        </div>
        <div class="now-row reveal delay-200">
          <span class="now-row-icon"><Icon name="learning" size={17} /></span>
          <div class="now-row-body">
            <h3 class="now-row-title">Learning in public</h3>
            <p class="now-row-desc">
              <a href={links.aiPlayground} class="link-accent" target="_blank" rel="noopener noreferrer">ai-playground</a> and <a href={links.languagePlayground} class="link-accent" target="_blank" rel="noopener noreferrer">language-playground</a> are open repos of experiments, notes, and rough edges.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       CONTACT
  ================================================================ -->
  <section id="contact" class="section-block contact-section">
    <HeroDotMatrix />
    <div class="container-site">
      <div class="contact-inner reveal">
        <p class="section-label">Contact</p>
        <h2 class="contact-heading">
          Let's build something<br />
          <span class="gradient-text">worth shipping.</span>
        </h2>
        <p class="contact-sub">
          For freelance projects and conversations, reach me by email or phone, or find me on GitHub, LinkedIn, and dev.to.
        </p>
        <div class="contact-ctas">
          <a href={`mailto:${links.email}`} class="btn">
            Send an email →
          </a>
          <span class="contact-email-plain">
            {links.email}
          </span>
        </div>
        <div class="contact-links">
          <a href={links.github} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} />GitHub</a>
          <a href={links.linkedin} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={16} />LinkedIn</a>
          <a href={links.devto} class="contact-link" target="_blank" rel="noopener noreferrer"><Icon name="devto" size={16} />dev.to</a>
          <a href={`tel:9883909187`} class="contact-link"><Icon name="phone" size={16} />+91 98839 09187</a>
          <span class="contact-location"><Icon name="location" size={16} />Kolkata, India</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ----------------------------------------------------------------
     Hero
  ---------------------------------------------------------------- */
  .hero-section {
    min-height: clamp(600px, calc(100svh - 65px), 860px);
    padding-block: 5rem 4rem;
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-inner {
    display: flex;
    align-items: center;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-name {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-role {
    margin: 0.5rem 0 0;
  }

  /* Role badge — solid cornflower, leaning top-left to top-right (parallelogram),
     sharp corners, white text; the title is counter-skewed so it reads upright. */
  .hero-role-badge {
    display: inline-block;
    padding: 0.45rem 0.9rem 0.45rem 1.1rem;
    background: var(--color-accent);
    border-radius: 0;
    transform: skewX(-8deg);
    transform-origin: center;
    box-shadow: 0 2px 0 color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
  .hero-role-text-inner {
    display: inline-block;
    transform: skewX(8deg);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .hero-direction {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    max-width: 58ch;
    margin: 0;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 0.25rem;
  }
  .hero-social {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .hero-social:hover {
    color: var(--color-accent-light);
  }

  /* Portrait */
  .hero-portrait {
    flex-shrink: 0;
  }
  .portrait-wrapper {
    position: relative;
    width: 220px;
    height: 220px;
  }
  /* Solid accent ring, visible on all sides at rest; on hover it shrinks down
     to the photo's own size (behind it) so the photo appears to press into/out
     from a solid backing. */
  .portrait-wrapper::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: -8px;
    background: var(--color-accent);
    clip-path: polygon(30% 4%, 70% 4%, 88% 18%, 100% 48%, 86% 78%, 50% 100%, 24% 90%, 10% 76%, 3% 56%, 6% 34%, 18% 12%);
    transition: inset 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }
  .hero-portrait:hover .portrait-wrapper::after {
    inset: 0;
    transform: translate(10px, 12px);
  }
  .portrait-img {
    position: relative;
    z-index: 1;
    width: 220px;
    height: 220px;
    object-fit: cover;
    background-color: #a9c8ff; /* light cornflower — photo backing, both themes */
    clip-path: polygon(30% 4%, 70% 4%, 88% 18%, 100% 48%, 86% 78%, 50% 100%, 24% 90%, 10% 76%, 3% 56%, 6% 34%, 18% 12%);
    transition: transform 0.35s ease;
  }
  .hero-portrait:hover .portrait-img {
    transform: translate(-6px, -6px);
  }

  /* ----------------------------------------------------------------
     Section scaffolding
  ---------------------------------------------------------------- */
  .section-block {
    padding-block: 5rem;
  }

  .section-alt {
    background: color-mix(in srgb, var(--color-surface) 40%, transparent);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0.375rem 0 0;
    color: var(--color-ink);
  }

  .section-subtitle {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
    max-width: 56ch;
  }

  /* ----------------------------------------------------------------
     Work grid
  ---------------------------------------------------------------- */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  /* ----------------------------------------------------------------
     More projects
  ---------------------------------------------------------------- */
  .more-projects {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
  .more-projects-label {
