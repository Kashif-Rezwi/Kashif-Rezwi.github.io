---
import Icon from './Icon.astro';
---

<fieldset class="theme-control">
  <legend class="sr-only">Color theme</legend>
  <span class="theme-control-thumb" aria-hidden="true"></span>

  <input id="theme-system" name="portfolio-theme-control" type="radio" value="system" checked />
  <label class="theme-choice choice-system" for="theme-system" title="Use system theme">
    <Icon name="system" size={15} />
    <span class="sr-only">System theme</span>
  </label>

  <input id="theme-light" name="portfolio-theme-control" type="radio" value="light" />
  <label class="theme-choice choice-light" for="theme-light" title="Use light theme">
    <Icon name="sun" size={15} />
    <span class="sr-only">Light theme</span>
  </label>

  <input id="theme-dark" name="portfolio-theme-control" type="radio" value="dark" />
  <label class="theme-choice choice-dark" for="theme-dark" title="Use dark theme">
    <Icon name="moon" size={15} />
    <span class="sr-only">Dark theme</span>
  </label>
</fieldset>

<style>
  .theme-control {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(3, 2rem);
    align-items: center;
    height: 2rem;
    margin: 0;
    padding: 0.125rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
  }

  .theme-control-thumb {
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 2rem;
    height: 1.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    pointer-events: none;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .theme-choice {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 1.75rem;
    place-items: center;
    border-radius: var(--radius-pill);
    color: var(--color-ink-dim);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
  }

  input:focus-visible + .theme-choice {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  input:checked + .theme-choice {
    color: var(--color-accent-text);
  }

  .theme-control:has(#theme-light:checked) .theme-control-thumb {
    transform: translateX(2rem);
  }

  .theme-control:has(#theme-dark:checked) .theme-control-thumb {
    transform: translateX(4rem);
  }

  :global(html[data-theme='light']) .theme-control-thumb {
    transform: translateX(2rem);
  }

  :global(html[data-theme='dark']) .theme-control-thumb {
    transform: translateX(4rem);
  }

  :global(html[data-theme='light']) .choice-light,
  :global(html[data-theme='dark']) .choice-dark,
  :global(html:not([data-theme])) .choice-system {
    color: var(--color-accent-text);
  }
</style>

<script>
  const key = 'portfolio-theme';
  const root = document.documentElement;
  const controls = document.querySelectorAll<HTMLInputElement>('input[name="portfolio-theme-control"]');

  const applyTheme = (theme: string) => {
    if (theme === 'light' || theme === 'dark') {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
    } else {
      delete root.dataset.theme;
      root.style.colorScheme = 'light dark';
    }
    window.dispatchEvent(new CustomEvent('portfolio-theme-change', { detail: theme }));
  };

  let saved: string | null = null;
  try {
    saved = localStorage.getItem(key);
  } catch {}
  const initial = saved === 'light' || saved === 'dark' ? saved : 'system';
  const active = [...controls].find((control) => control.value === initial);
  if (active) active.checked = true;

  controls.forEach((control) => {
    control.addEventListener('change', () => {
      if (!control.checked) return;
      try {
        localStorage.setItem(key, control.value);
      } catch {}
      applyTheme(control.value);
    });
  });
</script>
