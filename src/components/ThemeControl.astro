---
import Icon from './Icon.astro';
/**
 * Theme color control: system / light / dark segmented control.
 *
 * Rendered in the header on desktop and (optionally, via `idPrefix`) inside
 * the mobile drawer. Each instance must use a distinct `idPrefix` so the
 * radio inputs keep unique ids in the same document.
 */
interface Props {
  idPrefix?: string;
}
const { idPrefix = '' } = Astro.props;
const themeSystem = `${idPrefix}theme-system`;
const themeLight = `${idPrefix}theme-light`;
const themeDark = `${idPrefix}theme-dark`;
---

<fieldset class="theme-control">
  <legend class="sr-only">Color theme</legend>
  <span class="theme-control-thumb" aria-hidden="true"></span>

  <input id={themeSystem} name="portfolio-theme-control" type="radio" value="system" checked data-theme-control />
  <label class="theme-choice choice-system" for={themeSystem} title="Use system theme">
    <Icon name="system" size={15} />
    <span class="sr-only">System theme</span>
  </label>

  <input id={themeLight} name="portfolio-theme-control" type="radio" value="light" data-theme-control />
  <label class="theme-choice choice-light" for={themeLight} title="Use light theme">
    <Icon name="sun" size={15} />
    <span class="sr-only">Light theme</span>
  </label>

  <input id={themeDark} name="portfolio-theme-control" type="radio" value="dark" data-theme-control />
  <label class="theme-choice choice-dark" for={themeDark} title="Use dark theme">
    <Icon name="moon" size={15} />
    <span class="sr-only">Dark theme</span>
  </label>
</fieldset>

<style>
  .theme-control {
    position: relative;
    display: inline-grid;
    grid-template-columns: repeat(3, 2rem);
    align-items: center;
    height: 2rem;
    margin: 0;
    padding: 0.125rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
  }

  .theme-control-thumb {
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 2rem;
    height: 1.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    pointer-events: none;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .theme-choice {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 1.75rem;
    place-items: center;
    border-radius: var(--radius-pill);
    color: var(--color-ink-dim);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
  }

  input:focus-visible + .theme-choice {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  input:checked + .theme-choice {
    color: var(--color-accent-text);
  }

  .theme-control:has(input[value='light']:checked) .theme-control-thumb,
  :global(html[data-theme='light']) .theme-control-thumb {
    transform: translateX(2rem);
  }

  .theme-control:has(input[value='dark']:checked) .theme-control-thumb,
  :global(html[data-theme='dark']) .theme-control-thumb {
    transform: translateX(4rem);
  }

  :global(html[data-theme='light']) .choice-light,
  :global(html[data-theme='dark']) .choice-dark,
  :global(html:not([data-theme])) .choice-system {
    color: var(--color-accent-text);
  }
</style>

<script>
  const key = 'portfolio-theme';
  const root = document.documentElement;
  const controls = document.querySelectorAll<HTMLInputElement>('input[data-theme-control]');

  const applyTheme = (theme: string) => {
    if (theme === 'light' || theme === 'dark') {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
    } else {
      delete root.dataset.theme;
      root.style.colorScheme = 'light dark';
    }
    window.dispatchEvent(new CustomEvent('portfolio-theme-change', { detail: theme }));
  };

  let saved: string | null = null;
  try {
    saved = localStorage.getItem(key);
  } catch {}
  const initial = saved === 'light' || saved === 'dark' ? saved : 'system';
  controls.forEach((control) => {
    if (control.value === initial) control.checked = true;
  });

  controls.forEach((control) => {
    control.addEventListener('change', () => {
      if (!control.checked) return;
      try {
        localStorage.setItem(key, control.value);
      } catch {}
      applyTheme(control.value);
    });
  });
</script>
