---
// Footer per the brief (Part 2): colophon, repository link, last-updated note.
const year = new Date().getFullYear();
const lastUpdated = new Date().toISOString().slice(0, 10);
const repoUrl = 'https://github.com/Kashif-Rezwi/Kashif-Rezwi.github.io';
---

<footer class="border-t border-hairline/80">
  <div
    class="container-site flex flex-col gap-2 py-6 md:flex-row md:items-baseline md:justify-between"
  >
    <p class="font-mono text-xs text-ink-muted">
      © {year} Kashif Rezwi · Built with Astro · Hosted on GitHub Pages
    </p>
    <p class="font-mono text-xs text-ink-muted">
      <a href={repoUrl} class="link-accent">Source on GitHub</a>
      <span aria-hidden="true"> · </span>Last updated: {lastUpdated}
    </p>
  </div>
</footer>