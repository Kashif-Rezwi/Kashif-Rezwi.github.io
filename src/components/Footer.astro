---
const year = new Date().getFullYear();
const repoUrl = 'https://github.com/Kashif-Rezwi/Kashif-Rezwi.github.io';
const socials = [
  { label: 'GitHub', href: 'https://github.com/Kashif-Rezwi' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kashif-rezwi-149372216/' },
  { label: 'dev.to', href: 'https://dev.to/kashifrezwi' },
  { label: 'Email', href: 'mailto:kashifrezwi850@gmail.com' },
];
---

<footer>
  <div class="footer-inner container-site">
    <!-- Top: CTA -->
    <div class="footer-cta">
      <p class="footer-cta-text">Have a project or question?</p>
      <a href="mailto:kashifrezwi850@gmail.com" class="btn">Say hello →</a>
    </div>

    <hr class="footer-divider" />

    <!-- Bottom: nav + colophon -->
    <div class="footer-bottom">
      <p class="footer-copy">
        © {year} Kashif Rezwi
        <span class="footer-sep">·</span>
        <a href={repoUrl} class="link-accent footer-source">Source on GitHub</a>
      </p>
      <ul class="footer-socials" role="list">
        {socials.map((s) => (
          <li>
            <a href={s.href} class="footer-social-link" target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }

  .footer-inner {
    padding-block: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-cta-text {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .footer-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim);
    margin: 0;
  }

  .footer-sep {
    margin-inline: 0.5rem;
    color: var(--color-border);
  }

  .footer-source {
    font-size: 0.75rem;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-social-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-social-link:hover {
    color: var(--color-accent-light);
  }
</style>