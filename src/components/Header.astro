---
import { base, withBase, resumePdf } from '../lib/paths';
import ThemeControl from './ThemeControl.astro';

// Required nav order: Home · About · Skills · Projects · Contact · Resume.
// This single array drives BOTH the desktop list and the mobile drawer.
// "Projects" points at the existing #work section id (kept so the case-study
// "← Work" breadcrumb and the Now section's "See the work →" link keep
// working); the Resume entry carries a `resume` flag for its new-tab +
// auto-download behavior (see the script below).
const links = [
  { href: withBase('#home'), label: 'Home', resume: false },
  { href: withBase('#about'), label: 'About', resume: false },
  { href: withBase('#skills'), label: 'Skills', resume: false },
  { href: withBase('#work'), label: 'Projects', resume: false },
  { href: withBase('#contact'), label: 'Contact', resume: false },
  { href: resumePdf, label: 'Resume', resume: true },
];
---

<header id="site-header">
  <nav aria-label="Primary">
    <a href={base} class="logo" aria-label="Kashif Rezwi home">
      Kashif Rezwi
    </a>

    <!-- Desktop nav links -->
    <ul class="nav-links" role="list">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { accent: link.resume }]}
              target={link.resume ? '_blank' : undefined}
              rel={link.resume ? 'noopener noreferrer' : undefined}
              aria-label={
                link.resume
                  ? 'Resume (PDF, opens in a new tab and downloads)'
                  : undefined
              }
              {...(link.resume ? { 'data-resume-download': '' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-tools">
      <ThemeControl />
    </div>
    <button
      id="mobile-menu-btn"
      class="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </nav>

  <!-- Mobile nav drawer — `inert` when closed so links are not focusable/tab-reachable -->
  <div id="mobile-nav" class="mobile-nav" inert>
    <ul role="list">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['mobile-nav-link', { accent: link.resume }]}
              target={link.resume ? '_blank' : undefined}
              rel={link.resume ? 'noopener noreferrer' : undefined}
              aria-label={
                link.resume
                  ? 'Resume (PDF, opens in a new tab and downloads)'
                  : undefined
              }
              {...(link.resume ? { 'data-resume-download': '' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mobile-nav-theme">
      <ThemeControl idPrefix="menu-" />
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    /* R5 glass (spec §5.1): the navbar's historical frost becomes the token recipe. */
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border-bottom: 1px solid var(--glass-border);
    transition: background var(--duration-base) ease, border-color var(--duration-base) ease;
  }

  /* Fallback: no backdrop-filter support → near-opaque surface (S-9). */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    header {
      background: var(--glass-bg-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* OS transparency preference → solid (S-9). */
  @media (prefers-reduced-transparency: reduce) {
    header {
      background: var(--glass-bg-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1rem 1.5rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color var(--duration-fast) ease;
    white-space: nowrap;
  }
  .logo:hover {
    color: var(--color-accent-light);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.2s ease;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link:hover::after {
    width: 100%;
  }

  /* Resume accent on desktop mirrors the drawer's existing accent link. */
  .nav-link.accent {
    color: var(--color-accent-light);
  }
  .nav-link.accent:hover {
    color: var(--color-accent-text);
  }

  .nav-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  /* Mobile hamburger */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: var(--radius-control);
    transition: transform var(--duration-base) ease, opacity var(--duration-base) ease;
  }

  /* Mobile nav drawer — R5-5: same navbar glass recipe so the open drawer is
     one continuous glass panel with the fixed header. Blur is a static layer
     (never animated); fallbacks mirror the header. */
  .mobile-nav {
    display: none;
    overflow: hidden;
    max-height: 0;
    visibility: hidden;
    transition: max-height 0.3s ease;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border-top: 1px solid var(--glass-border);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .mobile-nav {
      background: var(--glass-bg-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .mobile-nav {
      background: var(--glass-bg-solid);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  .mobile-nav.is-open {
    /* Six links + list padding + theme row need more room than the old
       4-item drawer; oversized on purpose so nothing clips. */
    max-height: 26rem;
    visibility: visible;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-nav-link {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--glass-border);
    transition: color var(--duration-fast) ease;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link.accent {
    color: var(--color-accent-light);
  }
  .mobile-nav-link:last-child {
    border-bottom: none;
  }

  .mobile-nav-theme {
    display: flex;
    justify-content: center;
    padding: 0.5rem 1.5rem 1.25rem;
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem;
  }

  /* Hamburger → X animation when open */
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Tablet: six links + logo + theme control is tight in 641–768px —
     tighten gaps only (no label/layout changes). */
  @media (min-width: 641px) and (max-width: 768px) {
    nav {
      gap: 1rem;
    }
    .nav-links {
      gap: 0.875rem;
    }
  }

  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
    .nav-tools {
      margin-left: auto;
    }
    /* Theme control lives in the hamburger drawer; hide the header one. */
    .nav-tools :global(.theme-control) {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(isOpen));
    // `inert` while collapsed so links are not focusable or exposed to AT
    if (nav) nav.inert = !isOpen;
  });

  // Close mobile menu on link click
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      btn?.setAttribute('aria-expanded', 'false');
      nav.inert = true;
    });
  });

  // Navbar Resume (desktop + drawer): the anchor's default behavior opens
  // the PDF in a new tab (target="_blank"); within the same user gesture we
  // additionally trigger the download via a temporary same-origin anchor
  // carrying `download` (the PDF is same-origin on production and preview
  // builds, so the attribute is honoured). No-JS fallback: the link still
  // opens the resume in a new tab.
  document.querySelectorAll('[data-resume-download]').forEach((link) => {
    link.addEventListener('click', () => {
      const temp = document.createElement('a');
      temp.href = link.getAttribute('href') ?? '';
      temp.download = 'Kashif-Rezwi-Resume.pdf';
      document.body.appendChild(temp);
      temp.click();
      temp.remove();
    });
  });
</script>