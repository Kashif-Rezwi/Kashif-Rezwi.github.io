---
import { base, withBase } from '../lib/paths';
import ThemeControl from './ThemeControl.astro';

const links = [
  { href: withBase('#work'), label: 'Work' },
  { href: withBase('#experience'), label: 'Experience' },
  { href: withBase('#contact'), label: 'Contact' },
];
const resumeHref = withBase('resume/');
---

<header id="site-header">
  <nav aria-label="Primary">
    <a href={base} class="logo" aria-label="Kashif Rezwi home">
      Kashif Rezwi
    </a>

    <!-- Desktop nav links -->
    <ul class="nav-links" role="list">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="nav-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-tools">
      <ThemeControl />
      <a href={resumeHref} class="btn-outline nav-resume">Resume</a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="mobile-menu-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </nav>

  <!-- Mobile nav drawer — `inert` when closed so links are not focusable/tab-reachable -->
  <div id="mobile-nav" class="mobile-nav" inert>
    <ul role="list">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={resumeHref} class="mobile-nav-link accent">Resume</a>
      </li>
    </ul>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-canvas) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.3s ease;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1rem 1.5rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .logo:hover {
    color: var(--color-accent-light);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.2s ease;
  }
  .nav-link:hover {
    color: var(--color-ink);
  }
  .nav-link:hover::after {
    width: 100%;
  }

  .nav-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .nav-resume {
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
  }

  /* Mobile hamburger */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: var(--radius-control);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* Mobile nav drawer */
  .mobile-nav {
    display: none;
    overflow: hidden;
    max-height: 0;
    visibility: hidden;
    transition: max-height 0.3s ease;
    border-top: 1px solid var(--color-border);
  }
  .mobile-nav.is-open {
    max-height: 300px;
    visibility: visible;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-nav-link {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s ease;
  }
  .mobile-nav-link:hover,
  .mobile-nav-link.accent {
    color: var(--color-accent-light);
  }
  .mobile-nav-link:last-child {
    border-bottom: none;
  }

  /* Hamburger → X animation when open */
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 640px) {
    .nav-links,
    .nav-resume {
      display: none;
    }
    .nav-tools {
      margin-left: auto;
    }
    .mobile-menu-btn {
      display: flex;
    }
    .mobile-nav {
      display: block;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(isOpen));
    // `inert` while collapsed so links are not focusable or exposed to AT
    if (nav) nav.inert = !isOpen;
  });

  // Close mobile menu on link click
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      btn?.setAttribute('aria-expanded', 'false');
      nav.inert = true;
    });
  });
</script>