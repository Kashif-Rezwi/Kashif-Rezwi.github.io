---
/**
 * R3-D / Option B — GitHub contribution calendar, rendered as LOCAL SVG.
 *
 * Data comes from a build-time snapshot (src/data/github-contributions.json,
 * produced by scripts/fetch-github-contributions.mjs via GitHub's GraphQL API
 * with a read-only token). No client-side fetch, no third-party service, no
 * token in the browser. Squares are themed to the site's cornflower accent.
 *
 * Failure-honest: if the snapshot is missing or stale-flagged (`ok:false`),
 * renders a single plain link to the GitHub profile instead of fake data.
 */
import snapshot from '../data/github-contributions.json';

const CELL = 13;
const GAP = 3;
const R = 2.5;
const PITCH = CELL + GAP;
const MONTH_LABEL_H = 18;

interface Day {
  date: string;
  count: number;
  level: 'NONE' | 'FIRST_QUARTILE' | 'SECOND_QUARTILE' | 'THIRD_QUARTILE' | 'FOURTH_QUARTILE';
  weekday: number;
}

const ok = (snapshot as any)?.ok === true;
const weeks = ok ? ((snapshot as any).weeks as { days: Day[] }[]) : [];
const total = ok ? ((snapshot as any).totalContributions as number) : 0;
const fetchedAt = ok ? new Date((snapshot as any).fetchedAt) : null;
const refreshedLabel = fetchedAt
  ? fetchedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;

const levelClass: Record<Day['level'], string> = {
  NONE: 'gh-l0',
  FIRST_QUARTILE: 'gh-l1',
  SECOND_QUARTILE: 'gh-l2',
  THIRD_QUARTILE: 'gh-l3',
  FOURTH_QUARTILE: 'gh-l4',
};

// Month labels: when the month of a week's first day differs from the previous
// week's, emit a label at that column.
const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short' });
const monthLabels: { x: number; label: string }[] = [];
let prevMonth = -1;
weeks.forEach((week, wi) => {
  const first = week.days[0];
  if (!first) return;
  const m = new Date(first.date + 'T00:00:00').getMonth();
  if (m !== prevMonth) {
    monthLabels.push({ x: wi * PITCH, label: monthFmt.format(new Date(first.date + 'T00:00:00')) });
    prevMonth = m;
  }
});

const width = weeks.length * PITCH - GAP;
const height = MONTH_LABEL_H + 7 * PITCH - GAP;
const username = (snapshot as any)?.username ?? 'Kashif-Rezwi';
---

<div class="gh-contrib reveal">
  <div class="gh-contrib-card">
    <div class="gh-contrib-head">
      <p class="gh-contrib-label">GitHub activity</p>
      {
        ok && refreshedLabel && (
          <p class="gh-contrib-meta">
            <strong>{total.toLocaleString()}</strong> contributions in the last year · Last refreshed {refreshedLabel}
          </p>
        )
      }
    </div>
    {
      ok ? (
        <div class="gh-contrib-body">
          <div class="gh-contrib-scroll">
            <svg
              class="gh-contrib-svg"
              viewBox={`0 0 ${width} ${height}`}
              preserveAspectRatio="xMinYMid meet"
              role="img"
              aria-label={`GitHub contribution calendar, ${total} contributions in the last year`}
            >
              {monthLabels.map((m) => (
                <text class="gh-month" x={m.x} y={10}>{m.label}</text>
              ))}
              {weeks.map((week, wi) =>
                week.days.map((day) => (
                  <rect
                    class={levelClass[day.level] ?? 'gh-l0'}
                    x={wi * PITCH}
                    y={MONTH_LABEL_H + day.weekday * PITCH}
                    width={CELL}
                    height={CELL}
                    rx={R}
                  >
                    <title>{day.count} contribution{day.count === 1 ? '' : 's'} on {day.date}</title>
                  </rect>
                )),
              )}
            </svg>
          </div>
          <div class="gh-contrib-foot">
            <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer" class="gh-contrib-profile link-accent">@{username} on GitHub →</a>
            <div class="gh-contrib-legend" aria-hidden="true">
              <span>Less</span>
              <span class="gh-sq gh-l0" /><span class="gh-sq gh-l1" /><span class="gh-sq gh-l2" /><span class="gh-sq gh-l3" /><span class="gh-sq gh-l4" />
              <span>More</span>
            </div>
          </div>
        </div>
      ) : (
        <p class="gh-contrib-fallback">
          Contribution data isn't available right now.{' '}
          <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer" class="link-accent">View the activity graph on GitHub →</a>
        </p>
      )
    }
  </div>
</div>

<script>
  // On small screens the calendar scrolls horizontally; start at the most
  // recent end so the current activity is visible instead of the oldest.
  document.querySelectorAll('.gh-contrib-scroll').forEach((el) => {
    if (el.scrollWidth > el.clientWidth) el.scrollLeft = el.scrollWidth;
  });
</script>

<style>
  .gh-contrib {
    margin-top: 2.5rem;
  }
  .gh-contrib-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-card, 0.75rem);
    padding: 1.5rem 1.5rem 1.25rem;
    position: relative;
    /* No backdrop-filter: the card sits on the smooth work-section ambient
       band — nothing to blur, so no GPU layer is spent (spec §12). */
  }
  /* R5-3: top-edge catch light matches the shared glass vocabulary (kept local
     here; R5-6 may promote to the utility). */
  .gh-contrib-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--glass-highlight);
    border-radius: inherit;
    pointer-events: none;
  }
  /* Fallbacks: same solid-surface floor as the shared `.glass` utilities. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .gh-contrib-card {
      background: var(--glass-bg-solid);
    }
    .gh-contrib-card::before { display: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .gh-contrib-card {
      background: var(--glass-bg-solid);
    }
    .gh-contrib-card::before { display: none; }
  }

  .gh-contrib-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 1.25rem;
  }
  .gh-contrib-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim-glass);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  .gh-contrib-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-dim-glass);
    margin: 0;
  }
  .gh-contrib-meta strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .gh-contrib-svg {
    display: block;
    width: 100%;
    height: auto;
    /* Keep squares legible: never below ~7px cells (52 weeks * ~12px). */
    min-width: 620px;
  }
  .gh-contrib-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    /* Calendar scrolls to the most recent end on small screens, so fade the
       clipped LEFT edge to hint that earlier months are behind. */
    -webkit-mask-image: linear-gradient(to right, transparent, black 28px);
    mask-image: linear-gradient(to right, transparent, black 28px);
  }
  @media (min-width: 700px) {
    .gh-contrib-svg { min-width: 0; }
    .gh-contrib-scroll { -webkit-mask-image: none; mask-image: none; }
  }

  .gh-month {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--color-ink-dim-glass);
  }

  /* Level scale: empty = visible neutral tint; filled = cornflower at rising opacity. */
  /* SVG rects use fill; the HTML legend squares use background. */
  rect.gh-l0, .gh-sq.gh-l0 { fill: color-mix(in srgb, var(--color-ink) 7%, transparent); background: color-mix(in srgb, var(--color-ink) 7%, transparent); }
  rect.gh-l1, .gh-sq.gh-l1 { fill: color-mix(in srgb, var(--color-accent) 36%, transparent); background: color-mix(in srgb, var(--color-accent) 36%, transparent); }
  rect.gh-l2, .gh-sq.gh-l2 { fill: color-mix(in srgb, var(--color-accent) 60%, transparent); background: color-mix(in srgb, var(--color-accent) 60%, transparent); }
  rect.gh-l3, .gh-sq.gh-l3 { fill: color-mix(in srgb, var(--color-accent) 84%, transparent); background: color-mix(in srgb, var(--color-accent) 84%, transparent); }
  rect.gh-l4, .gh-sq.gh-l4 { fill: var(--color-accent); background: var(--color-accent); }

  .gh-contrib-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.125rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .gh-contrib-profile {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }
  .gh-contrib-profile:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .gh-contrib-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-dim-glass);
  }
  .gh-contrib-legend .gh-sq {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }

  .gh-contrib-fallback {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>
