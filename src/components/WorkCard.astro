---
/**
 * Featured work card — R3-C normalized anatomy.
 * Order is contractual: media → role/status → title → summary → tech → actions.
 * Covers load via Vite glob (same pattern as [slug].astro).
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  roleLabel: string;
  period: string;
  status: string;
  summary: string;
  repo: string;
  demo?: string;
  tech: string[];
  href: string;
  cover?: string; // filename inside src/assets/work/
}

const { title, roleLabel, period, status, summary, repo, demo, tech, href, cover } =
  Astro.props;

const covers = import.meta.glob('../assets/work/*', {
  eager: true,
  import: 'default',
}) as Record<string, { src: string; width: number; height: number }>;
const coverSrc = cover ? covers[`../assets/work/${cover}`] : undefined;

const VISIBLE_TECH = 4;
const visibleTech = tech.slice(0, VISIBLE_TECH);
const hiddenTechCount = tech.length - visibleTech.length;
---

<article class="work-card card">
  {
    coverSrc && (
      <div class="work-card-cover">
        <img src={coverSrc.src} alt={`${title} screenshot`} loading="lazy" width={coverSrc.width} height={coverSrc.height} />
      </div>
    )
  }
  <div class="work-card-body">
    <header class="work-card-header">
      <div class="work-card-meta-row">
        <span class="section-label">{roleLabel}</span>
        <span class="work-card-status">{status}</span>
      </div>
      <h3 class="work-card-title">
        <a href={href}>{title}</a>
      </h3>
      <p class="work-card-period">{period}</p>
    </header>

    <p class="work-card-summary">{summary}</p>

    <ul class="work-card-tech" aria-label={`Key technologies in ${title}; full list in the case study`}>
      {visibleTech.map((t) => <li class="tech-tag">{t}</li>)}
      {
        hiddenTechCount > 0 && (
          <li>
            <a class="work-card-tech-more" href={href} aria-label={`${hiddenTechCount} more technologies — see the ${title} case study`}>
              +{hiddenTechCount} more
            </a>
          </li>
        )
      }
    </ul>

    <footer class="work-card-actions">
      <a href={href} class="btn-outline work-card-primary">
        Read case study <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a
        href={repo}
        class="work-card-link link-accent"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="repository" size={14} />Repo
      </a>
      {
        demo && (
          <a
            href={demo}
            class="work-card-link link-accent"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="external" size={14} />Live demo
          </a>
        )
      }
    </footer>
  </div>
</article>

<style>
  .work-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .work-card-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-2);
  }
  .work-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s ease;
  }
  .work-card:hover .work-card-cover img {
    transform: scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card-cover img {
      transition: none;
    }
    .work-card:hover .work-card-cover img {
      transform: none;
    }
  }

  .work-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
  }

  .work-card-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .work-card-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  /* Status is neutral metadata — never a success-colored claim. */
  .work-card-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-dim);
    font-weight: 500;
    white-space: nowrap;
  }

  .work-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .work-card-title a {
    color: var(--color-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .work-card-title a:hover {
    color: var(--color-accent-light);
  }

  .work-card-period {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-dim);
    margin: 0;
  }

  /* Consistent two-line summary slot keeps card heights aligned. */
  .work-card-summary {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(2 * 1.6 * 0.9375rem);
  }

  .work-card-tech {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work-card-tech-more {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-dim);
    text-decoration: none;
    border-radius: var(--radius-control);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .work-card-tech-more:hover {
    color: var(--color-accent-text);
    background: var(--color-accent-soft);
  }

  .work-card-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .work-card-primary {
    padding: 0.375rem 0.875rem;
  }
  .work-card-primary .arrow {
    transition: transform 0.2s ease;
  }
  .work-card-primary:hover .arrow {
    transform: translateX(3px);
  }

  .work-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
</style>
