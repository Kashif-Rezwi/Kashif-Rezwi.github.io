---
/** Local, dependency-free icon registry. Icons are decorative when a visible label
 * is adjacent; use `label` only for standalone meaningful icon controls. */
interface Props {
  name:
    | 'github'
    | 'linkedin'
    | 'devto'
    | 'mail'
    | 'phone'
    | 'resume'
    | 'location'
    | 'external'
    | 'repository'
    | 'sun'
    | 'moon'
    | 'system'
    | 'sparkles'
    | 'writing'
    | 'learning'
    | 'react'
    | 'nextjs'
    | 'typescript'
    | 'git'
    | 'tailwind'
    | 'mongodb'
    | 'redis'
    | 'javascript'
    | 'python'
    | 'redux'
    | 'nodejs'
    | 'express'
    | 'nestjs'
    | 'websocket'
    | 'rest'
    | 'rabbitmq'
    | 'postgres'
    | 'clickhouse'
    | 'docker'
    | 'ghactions'
    | 'vercel'
    | 'prisma'
    | 'pgvector'
    | 'bullmq'
    | 'tanstack';
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, label, class: className } = Astro.props;
const titleId = label ? `icon-${name}-${crypto.randomUUID()}` : undefined;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-labelledby={titleId}
  focusable="false"
>
  {label && <title id={titleId}>{label}</title>}
  {name === 'github' && <path d="M15 22v-3.9c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6.2 0-1.4-.5-2.5-1.3-3.4.1-.3.6-1.7-.1-3.4 0 0-1.1-.4-3.5 1.3a12.2 12.2 0 0 0-6.3 0C6.4 2.7 5.3 3.1 5.3 3.1c-.7 1.7-.2 3.1-.1 3.4A4.8 4.8 0 0 0 3.9 10c0 4.8 2.7 5.9 5.5 6.2-.4.4-.6.9-.6 1.8V22M9 19c-2.5.8-3-1.2-4-1.5" />}
  {name === 'linkedin' && <><path d="M6.5 9.5V18" /><path d="M6.5 6.5v.01" /><path d="M10.5 18v-5c0-2 1.2-3.5 3.2-3.5s3.3 1.5 3.3 3.5v5" /><path d="M10.5 12.3V9.5" /></>}
  {name === 'devto' && <><path d="M3.5 5.5h17v13h-17z" /><path d="M7 9v5" /><path d="M10 9.5h1.1a2.5 2.5 0 0 1 0 5H10z" /><path d="M15 9.5h3" /><path d="M15 12h2.5" /><path d="M15 14.5h3" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'phone' && <path d="M5 4.5 8 4l1.6 4-1.9 1.5a14 14 0 0 0 6.8 6.8l1.5-1.9 4 1.6-.5 3c-.2 1.2-1.3 2-2.5 1.8C9.5 19.5 4.5 14.5 3.2 7c-.2-1.2.6-2.3 1.8-2.5Z" />}
  {name === 'resume' && <><path d="M7 3.5h7l3 3V20.5H7z" /><path d="M14 3.5v3h3" /><path d="M10 11h4" /><path d="M10 14.5h4" /></>}
  {name === 'location' && <><path d="M20 10.5c0 5-8 10-8 10s-8-5-8-10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10.5" r="2.5" /></>}
  {name === 'external' && <><path d="M14 4h6v6" /><path d="m20 4-9 9" /><path d="M18 13v6.5H4.5V6H11" /></>}
  {name === 'repository' && <><path d="M4 5.5h6l1.5 2H20v11H4z" /><path d="M4 9.5h16" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {name === 'moon' && <path d="M20.5 15.3A8.5 8.5 0 0 1 8.7 3.5 8.5 8.5 0 1 0 20.5 15.3Z" />}
  {name === 'system' && <>
    {/* Device-aware "system" glyph: shows monitor / tablet / phone by viewport */}
    <g class="sys-desktop"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></g>
    <g class="sys-tablet"><rect x="5" y="3.5" width="14" height="17" rx="2" /><path d="M9.5 6h5" /><path d="M12 16.6v.1" /></g>
    <g class="sys-phone"><rect x="7" y="3.5" width="10" height="17" rx="2.5" /><path d="M10.5 6h3" /><path d="M12 16.5v.1" /></g>
  </>}
  {name === 'sparkles' && <><path d="m12 3 1.2 4.8L18 9l-4.8 1.2L12 15l-1.2-4.8L6 9l4.8-1.2Z" /><path d="m19 15 .6 2.4L22 18l-2.4.6L19 21l-.6-2.4L16 18l2.4-.6Z" /></>}
  {name === 'writing' && <><path d="m4 20 4.2-1 10-10a2.1 2.1 0 0 0-3-3l-10 10z" /><path d="m13.8 7.2 3 3" /><path d="M4 20h6" /></>}
  {name === 'learning' && <><path d="M4 5.5h6.5A2.5 2.5 0 0 1 13 8v11H6a2 2 0 0 0-2 2z" /><path d="M20 5.5h-6.5A2.5 2.5 0 0 0 11 8v11h7a2 2 0 0 1 2 2z" /></>}
  {name === 'react' && <><circle cx="12" cy="12" r="2.1" /><ellipse cx="12" cy="12" rx="9.3" ry="3.7" /><ellipse cx="12" cy="12" rx="9.3" ry="3.7" transform="rotate(60 12 12)" /><ellipse cx="12" cy="12" rx="9.3" ry="3.7" transform="rotate(120 12 12)" /></>}
  {name === 'nextjs' && <><circle cx="12" cy="12" r="8.4" /><path d="M7.6 16.5v-9l8.8 9" /><path d="M16.4 8v8.5" /></>}
  {name === 'typescript' && <><rect x="4.5" y="4.5" width="15" height="15" rx="2.5" /><path d="M8.2 9v2" /><path d="M9 7h1.5" /><path d="M12 7v6" /><path d="M12 12.5c0-.5.6-1 1.7-1v1.1" /><path d="M12 15.2v.6" /><path d="M15 8v3" /><path d="M15 8h-1.5" /></>}
  {name === 'git' && <><circle cx="6.5" cy="6" r="2.4" /><circle cx="6.5" cy="18" r="2.4" /><circle cx="17" cy="7" r="2.4" /><path d="M6.5 8.4v7.2" /><path d="M8.9 7.5c4.5 0 4.5 2 5 4.5" /></>}
  {name === 'tailwind' && <><path d="M6 15c1.5-4 3-6 5-6s3.5 2 5 2 2-1 2-2c-1.5 4-3 6-5 6s-3.5-2-5-6c-1.5 0-2 0-2 2z" /><path d="M6 8C4.5 4 6 2 8 2s3.5 2 5 6-3.5 6-5 6-2.5-2-2-6c-.5 0-1 0-1 0z" /></>}
  {name === 'mongodb' && <><path d="M12 4c1.2 4.5 1.5 8 0 6" /><path d="M12 10c0 8-5 10-5 10s6-1 7-15" /><path d="M12 10c0 8 5 10 5 10s-6-1-7-15" /><path d="M12 4v16" /></>}
  {name === 'redis' && <><path d="M4 9h16" /><path d="M4 13.5h16" /><path d="M4 18h9" /><path d="m7 5 1.5 1.6L10 5" /></>}
  {name === 'javascript' && <><rect x="4" y="4.5" width="16" height="15" rx="2" /><path d="M13 10.5c.3-1.4 1-2 2-2 1.5 0 2.5 1 2.5 2.7v5.3M8 13.3l1.2 1.2L10.5 13" /><path d="M8 15.5l1.2-1.2 1.3 1.2" /></>}
  {name === 'python' && <><path d="M12 4c-2 0-6 .5-6 6v.5l6 2.5 6-2.5V10c0-5.5-4-6-6-6Z" /><path d="M12 20c2 0 6-.5 6-6v-.5l-6-2.5-6 2.5V14c0 5.5 4 6 6 6Z" /><circle cx="12" cy="7" r="0.5" /><circle cx="12" cy="17" r="0.5" /></>}
  {name === 'redux' && <><path d="M12 4v16" /><path d="M12 5.5 7 3v5.5z" /><path d="M5.5 10.5c5.5 0 6.5 2.5 6.5 2.5s1-2.5 6.5-2.5" /><circle cx="18" cy="13" r="1.5" /></>}
  {name === 'tanstack' && <><path d="M3.5 20 8 12l3 5 5-9" /><path d="M16 8h3.5v3.5" /></>}
  {name === 'nodejs' && <><path d="M12 3 19.5 7v10L12 21 4.5 17V7z" /><path d="M12 3 19.5 7v10L12 21 4.5 17V7z" opacity="0" /><circle cx="12" cy="12" r="1" /></>}
  {name === 'express' && <><path d="M3 12c5.5 0 6.5-8 6-8 0 8 13 8 0 8s-6-8-6-8z" /></>}
  {name === 'nestjs' && <><path d="m12 3 3 2.5-3 3" /><path d="m12 6 4.5 1.5L4.5 14" /><path d="m12 21 3-2.5-3-3" /><path d="M4.5 5v14L4.5 5Z" /></>}
  {name === 'websocket' && <><circle cx="8" cy="8" r="3.5" /><circle cx="16" cy="16" r="3.5" /><path d="M10.5 9.5 13.5 14.5" /></>}
  {name === 'rest' && <><path d="M4 8h8" /><path d="M14 8l-2-2M14 8l-2 2" /><path d="M20 16h-8" /><path d="M10 16l2-2M10 16l2 2" /></>}
  {name === 'rabbitmq' && <><path d="M3.5 20V11.5M3.5 8h3v3H3.5M6.5 8V5h2.5V11" /><path d="M6.5 11V17h7" /><path d="M6.5 8.5H9" /><path d="M13.5 17h4V11M11 17v3M20 17h1" /></>}
  {name === 'postgres' && <><ellipse cx="12" cy="5.5" rx="7" ry="2.5" /><path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13" /><path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5" /></>}
  {name === 'clickhouse' && <><path d="M6 4h2v13h-2z" /><path d="M11 8h2v9h-2z" /><path d="M16 4h2v13h-2z" /><path d="M4 20h17" /></>}
  {name === 'docker' && <><path d="M3.5 10.5h11v4.5a3.5 3.5 0 0 1-3.5 3.5H7a3.5 3.5 0 0 1-3.5-3.5z" /><path d="M3.5 13h11" /><path d="M14.5 6h1M16.5 6h1M16.5 8h1" /></>}
  {name === 'ghactions' && <><rect x="3.5" y="3.5" width="17" height="17" rx="3" /><circle cx="12" cy="12" r="3" /><path d="M12 9V7.5M12 16.5V15M9 12H7.5M16.5 12H15M10 10l-1-1M15 15l-1-1M14 10l1-1M10 14l-1 1" /></>}
  {name === 'vercel' && <path d="M12 4 20.5 20h-17z" />}
  {name === 'prisma' && <><path d="m12 3 8.5 14H3.5z" /><path d="m12 3-3.5 14 3.5 4 3.5-4z" /></>}
  {name === 'pgvector' && <><ellipse cx="12" cy="5.5" rx="7" ry="2.5" /><path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13" /><path d="M14 13.5 16 12l2 1V9.5" /></>}
  {name === 'bullmq' && <><path d="M13 3 6 13h4l-3 8 7-9h-4l3-8z" /></>}
</svg>

<style>
  /* Device-aware "system" glyph: show the device matching the viewport.
     Default (no override) = desktop monitor. */
  .sys-desktop,
  .sys-tablet,
  .sys-phone {
    display: none;
  }
  :global(.theme-choice.choice-system) .sys-desktop {
    display: inline;
  }
  /* Tablets: 641px–1024px */
  @media (min-width: 641px) and (max-width: 1024px) {
    :global(.theme-choice.choice-system) .sys-desktop {
      display: none;
    }
    :global(.theme-choice.choice-system) .sys-tablet {
      display: inline;
    }
  }
  /* Phones: ≤640px (matches the hamburger/ThemeControl breakpoint) */
  @media (max-width: 640px) {
    :global(.theme-choice.choice-system) .sys-desktop {
      display: none;
    }
    :global(.theme-choice.choice-system) .sys-phone {
      display: inline;
    }
  }
</style>
